# Shared by the backup scripts (sourced, not run).

log() { echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) $*"; }
fail() { log "error: $*" >&2; exit 1; }
require() { for name in "$@"; do eval "[ -n \"\${$name:-}\" ]" || fail "$name is not set"; done; }

# The databases in the PostgreSQL accessory: Fenaki, listmonk (waitlist and newsletter), Umami.
DATABASES="${BACKUP_DATABASES:-fenaki listmonk umami}"

# rclone remote `offsite:` from the environment. BACKUP_S3_PROVIDER is rclone's S3 provider:
# `Cloudflare` for R2, `Other` for Backblaze B2's S3 API, `Rclone` for the local rehearsal.
offsite_setup() {
  require BACKUP_S3_ENDPOINT BACKUP_S3_BUCKET BACKUP_S3_ACCESS_KEY_ID BACKUP_S3_SECRET_ACCESS_KEY
  export RCLONE_CONFIG_OFFSITE_TYPE=s3
  export RCLONE_CONFIG_OFFSITE_PROVIDER="${BACKUP_S3_PROVIDER:-Other}"
  export RCLONE_CONFIG_OFFSITE_ENDPOINT="$BACKUP_S3_ENDPOINT"
  export RCLONE_CONFIG_OFFSITE_ACCESS_KEY_ID="$BACKUP_S3_ACCESS_KEY_ID"
  export RCLONE_CONFIG_OFFSITE_SECRET_ACCESS_KEY="$BACKUP_S3_SECRET_ACCESS_KEY"
  export RCLONE_CONFIG_OFFSITE_REGION="${BACKUP_S3_REGION:-auto}"
  export RCLONE_CONFIG_OFFSITE_ENV_AUTH=false
  # API tokens scoped to one bucket cannot create or list buckets.
  export RCLONE_CONFIG_OFFSITE_NO_CHECK_BUCKET="${BACKUP_S3_NO_CHECK_BUCKET:-true}"
  OFFSITE="offsite:$BACKUP_S3_BUCKET/${BACKUP_S3_PREFIX:-daily}"
}
