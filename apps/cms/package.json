{
  "name": "@fenaki/cms",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Payload CMS: admin panel, REST API and background jobs for the Fenaki catalog.",
  "exports": {
    "./types": "./src/payload-types.ts"
  },
  "scripts": {
    "dev": "pnpm run --parallel \"/^dev:.*/\"",
    "dev:next": "NODE_OPTIONS=--no-deprecation next dev --port 3000",
    "dev:jobs": "pnpm run jobs",
    "build": "NODE_OPTIONS=--no-deprecation next build",
    "start": "NODE_OPTIONS=--no-deprecation next start --port 3000",
    "jobs": "NODE_OPTIONS=--no-deprecation payload jobs:run --cron \"*/10 * * * * *\" --queue default --handle-schedules",
    "seed": "NODE_OPTIONS=--no-deprecation payload run src/seed/index.ts",
    "import:catalog": "NODE_OPTIONS=--no-deprecation payload run src/import/index.ts",
    "import:organizations": "NODE_OPTIONS=--no-deprecation payload run src/import/organizations.ts",
    "backfill:still-text": "NODE_OPTIONS=--no-deprecation payload run src/ingest/backfillStillText.ts",
    "reindex": "NODE_OPTIONS=--no-deprecation payload run src/search/reindex.ts",
    "migrate": "NODE_OPTIONS=--no-deprecation payload migrate",
    "migrate:create": "NODE_OPTIONS=--no-deprecation payload migrate:create",
    "migrate:status": "NODE_OPTIONS=--no-deprecation payload migrate:status",
    "payload": "NODE_OPTIONS=--no-deprecation payload",
    "generate:types": "NODE_OPTIONS=--no-deprecation payload generate:types",
    "generate:importmap": "NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "typecheck": "tsc",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@fenaki/i18n": "workspace:*",
    "@fenaki/waitlist": "workspace:*",
    "@payloadcms/db-postgres": "3.92.0",
    "@payloadcms/email-nodemailer": "3.92.0",
    "@payloadcms/next": "3.92.0",
    "@payloadcms/translations": "3.92.0",
    "@payloadcms/ui": "3.92.0",
    "@sentry/node": "11.9.0",
    "graphql": "16.14.2",
    "imapflow": "2.9.1",
    "mailparser": "3.12.4",
    "meilisearch": "0.62.0",
    "next": "16.4.3",
    "nodemailer": "10.2.1",
    "payload": "3.92.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@types/mailparser": "3.9.0",
    "@types/node": "26.6.5",
    "@types/nodemailer": "8.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
