# Payload CMS. Copy to .env for local development; never commit .env.
DATABASE_URL=postgres://shortix:shortix@127.0.0.1:5432/shortix
# Any long random string. Generate one with: openssl rand -hex 32
PAYLOAD_SECRET=change-me-to-a-long-random-string
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000
# The Astro site, allowed by CORS.
WEB_URL=http://localhost:4321

# Meilisearch: the master key from docker-compose.yml in development.
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_ADMIN_KEY=shortix-dev-master-key-change-me

# Admin user created by the seed script (local development only).
SEED_ADMIN_EMAIL=admin@shortix.local
SEED_ADMIN_PASSWORD=change-me-locally

# The real catalog import file (`pnpm import:catalog`). It lives outside this public repository:
# use an absolute path.
CATALOG_IMPORT_PATH=/path/to/private/catalogo/import.json

# listmonk, for the daily job that removes waitlist signups never confirmed (links last 7 days).
# Same API user and token as apps/web/.env. Without a token the job does nothing.
LISTMONK_URL=http://localhost:9000
LISTMONK_API_USER=shortix-web
LISTMONK_API_TOKEN=shortix-dev-listmonk-token-change-me

# Payload's account emails (password resets). Empty SMTP_HOST writes them to the console. To see
# them in Mailpit locally: SMTP_HOST=127.0.0.1, SMTP_PORT=1025, SMTP_TLS=none. In production,
# Amazon SES (docs/deploy.md). SMTP_TLS: STARTTLS (port 587), TLS (port 465) or none.
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=STARTTLS
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=hola@fenaki.tv
EMAIL_FROM_NAME=Shortix

# Sentry error tracking (EU region). Empty: off.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
