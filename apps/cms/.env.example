# Payload CMS. Copy to .env for local development; never commit .env.
DATABASE_URL=postgres://fenaki:fenaki@127.0.0.1:5432/fenaki
# Any long random string. Generate one with: openssl rand -hex 32
PAYLOAD_SECRET=change-me-to-a-long-random-string
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000
# The Astro site, allowed by CORS.
WEB_URL=http://localhost:4321

# Meilisearch: the master key from docker-compose.yml in development.
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_ADMIN_KEY=fenaki-dev-master-key-change-me

# Admin user created by the seed script (local development only).
SEED_ADMIN_EMAIL=admin@fenaki.local
SEED_ADMIN_PASSWORD=change-me-locally

# The real catalog import file (`pnpm import:catalog`). It lives outside this public repository:
# use an absolute path.
CATALOG_IMPORT_PATH=/path/to/private/catalogo/import.json

# listmonk, for the daily job that removes waitlist signups never confirmed (links last 7 days).
# Same API user and token as apps/web/.env. Without a token the job does nothing.
LISTMONK_URL=http://localhost:9000
LISTMONK_API_USER=fenaki-web
LISTMONK_API_TOKEN=fenaki-dev-listmonk-token-change-me

# Umami, for the nightly job that ranks «Lo más visto» from the `play` events of the last 7 days.
# Same instance, website and login as apps/web/.env. Without them the job does nothing and the
# ranking stays as it was.
UMAMI_URL=http://localhost:3001
UMAMI_WEBSITE_ID=6f1d9a52-3c1e-4c8a-9a51-5b7e2d4c8f10
UMAMI_USERNAME=admin
UMAMI_PASSWORD=umami

# Payload's account emails (password resets). Empty SMTP_HOST writes them to the console. To see
# them in Mailpit locally: SMTP_HOST=127.0.0.1, SMTP_PORT=1025, SMTP_TLS=none. In production,
# Amazon SES (docs/deploy.md). SMTP_TLS: STARTTLS (port 587), TLS (port 465) or none.
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=STARTTLS
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=hola@fenaki.tv
EMAIL_FROM_NAME=Fenaki

# The sales CRM's mailbox (hola@fenaki.tv on OVHcloud Zimbra Starter). Outreach goes out through
# its SMTP server and replies are read over IMAP (read-only); a copy of each sent email is
# appended to its Sent folder. Separate from the SMTP_* settings above (Amazon SES: Payload's own
# emails). Settings: https://docs.ovhcloud.com/en/guides/web-cloud/email-and-collaborative-solutions/zimbra/mail-apps
# (Americas and Asia-Pacific accounts use imap.mail.ovh.ca and smtp.mail.ovh.ca). Locally, point
# SMTP at Mailpit (127.0.0.1, 1025) and IMAP at a test server such as GreenMail (3143), or leave
# the IMAP host empty: the inbox sync is then off. Ports: IMAP 993 is implicit TLS; SMTP 465 is
# implicit TLS and 587 is STARTTLS. Without the host, user and password nothing is sent.
MAILBOX_USER=
MAILBOX_PASSWORD=
MAILBOX_IMAP_HOST=
MAILBOX_IMAP_PORT=993
MAILBOX_SMTP_HOST=
MAILBOX_SMTP_PORT=465
# Optional: the Sent folder's name, when it is not found by itself.
MAILBOX_SENT_FOLDER=
# At most this many outreach emails per day (Madrid time).
CRM_DAILY_SEND_LIMIT=20
# The organizations CSV (`pnpm --filter @fenaki/cms import:organizations`), outside this repository.
CRM_IMPORT_PATH=/path/to/private/comercial/organizaciones.csv

# Sentry error tracking (EU region). Empty: off.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# Optional metadata APIs for «Add a short from a URL» and the nightly embed checker. Without them
# both use only the public oEmbed endpoints (no running time for YouTube, no age restriction).
# YouTube Data API v3 key: duration, channel id, embeddability and age restriction (1 quota unit
# per 50 videos). TMDB: a v3 API key or a v4 read access token.
YOUTUBE_API_KEY=
TMDB_API_KEY=
