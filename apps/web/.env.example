# Astro site. Copy to .env for local development; never commit .env.
CMS_URL=http://localhost:3000
# The CMS's public address, where the browser loads media (logos) from, when CMS_URL is an internal
# one (production). Empty: CMS_URL.
CMS_PUBLIC_URL=
MEILISEARCH_HOST=http://127.0.0.1:7700
# A search-only key in production. Locally, the master key from docker-compose.yml works.
MEILISEARCH_SEARCH_KEY=fenaki-dev-master-key-change-me

# The public site URL, for links in emails (the waitlist confirmation link).
SITE_URL=http://localhost:4321
# `landing`: /es/ is the pre-launch landing page and the catalog routes are not public.
# `catalog`: the full site.
SITE_MODE=catalog
# Shows the «Borrador» notice on the legal pages until a lawyer has reviewed them.
LEGAL_DRAFT=false
# Prefix of the search index names (the e2e tests use their own, `test_`).
SEARCH_INDEX_PREFIX=

# listmonk (waitlist and newsletter). The token matches docker-compose.yml locally.
LISTMONK_URL=http://localhost:9000
LISTMONK_API_USER=fenaki-web
LISTMONK_API_TOKEN=fenaki-dev-listmonk-token-change-me
LISTMONK_FROM_EMAIL=FENAKI <hola@fenaki.tv>
# listmonk's public address, for the unsubscribe links in its emails, when LISTMONK_URL is an
# internal one (production). Empty: LISTMONK_URL.
LISTMONK_PUBLIC_URL=
# The SMTP server listmonk sends through, as `pnpm setup:services` configures it. Locally, Mailpit
# (host as seen from the listmonk container). In production, Amazon SES in an EU region:
#   LISTMONK_SMTP_HOST=email-smtp.eu-west-1.amazonaws.com  LISTMONK_SMTP_PORT=587
#   LISTMONK_SMTP_AUTH=login  LISTMONK_SMTP_TLS=STARTTLS
#   LISTMONK_SMTP_USERNAME / LISTMONK_SMTP_PASSWORD = the SES SMTP credentials
LISTMONK_SMTP_HOST=mailpit
LISTMONK_SMTP_PORT=1025
LISTMONK_SMTP_AUTH=none
LISTMONK_SMTP_TLS=none
LISTMONK_SMTP_USERNAME=
LISTMONK_SMTP_PASSWORD=

# Umami (cookieless analytics). Leave UMAMI_SCRIPT_URL empty to load no tracking script.
UMAMI_URL=http://localhost:3001
UMAMI_SCRIPT_URL=http://localhost:3001/script.js
UMAMI_WEBSITE_ID=6f1d9a52-3c1e-4c8a-9a51-5b7e2d4c8f10
UMAMI_WEBSITE_DOMAIN=localhost
# Used only by `pnpm setup:services`. Umami's first-run login; change it in production.
UMAMI_USERNAME=admin
UMAMI_PASSWORD=umami

# The public contact mailbox. When set, the landing and the footer show «Proponer un corto» and
# the sponsorship links (mailto); empty hides them.
CONTACT_EMAIL=

# Sentry error tracking (EU region), server side only. Empty: off.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# Development only: fill the «Lo más visto» rail with the 10 latest published shorts, to work on
# its design. In production the rail shows only a real ranking (computed by the CMS from Umami's
# play events) and this flag is ignored.
TOP10_PREVIEW=false
