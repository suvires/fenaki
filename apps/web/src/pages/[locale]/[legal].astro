---
import { formatDate } from '@fenaki/i18n'
import { Notice, Prose } from '@fenaki/ui'
import { getEntry, render } from 'astro:content'
import TextPage from '../../layouts/TextPage.astro'
import { isLegalPage, localeFrom, translator } from '../../lib/i18n.ts'
import { legalDraft } from '../../lib/services.ts'

const locale = localeFrom(Astro.params.locale)
const page = Astro.params.legal
if (!locale || !isLegalPage(page)) return Astro.rewrite('/404')

const entry = await getEntry('legal', `${locale}/${page}`)
if (!entry) return Astro.rewrite('/404')

const t = translator(locale)
const { Content } = await render(entry)
const { title, updated } = entry.data
const lead = updated ? t('legal.updated', { date: formatDate(updated, locale) }) : undefined
---

<TextPage locale={locale} title={title} lead={lead}>
  {legalDraft && <Notice label={t('legal.draft.label')}>{t('legal.draft.text')}</Notice>}
  <Prose>
    <Content />
  </Prose>
</TextPage>
