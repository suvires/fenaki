---
import { Prose, TmdbLogo } from '@fenaki/ui'
import Base from '../../layouts/Base.astro'
import { localeFrom, translator } from '../../lib/i18n.ts'

const locale = localeFrom(Astro.params.locale)
if (!locale) return Astro.rewrite('/404')
const t = translator(locale)
---

<Base locale={locale} title={t('credits.title')}>
  <Prose>
    <h1>{t('credits.title')}</h1>
    <p>{t('credits.intro')}</p>

    <h2>{t('credits.shorts.title')}</h2>
    <p>{t('credits.shorts.text')}</p>

    <h2>{t('credits.tmdb.title')}</h2>
    <p>
      <a href="https://www.themoviedb.org" rel="noopener" class="inline-flex">
        <TmdbLogo label={t('credits.tmdb.logo')} className="h-6 w-auto" />
      </a>
    </p>
    <p lang="en">{t('credits.tmdb.notice')}</p>
    <p>{t('credits.tmdb.translation')}</p>

    <h2>{t('credits.youtube.title')}</h2>
    <p>{t('credits.youtube.text')}</p>
    <ul>
      <li>
        <a href="https://www.youtube.com/t/terms" rel="noopener">
          {t('credits.youtube.terms')}
        </a>
      </li>
      <li>
        <a href="https://policies.google.com/privacy" rel="noopener">
          {t('credits.youtube.privacy')}
        </a>
      </li>
    </ul>

    <h2>{t('credits.fonts.title')}</h2>
    <p>{t('credits.fonts.text')}</p>
  </Prose>
</Base>
