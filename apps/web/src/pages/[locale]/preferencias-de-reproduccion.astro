---
import { PlayerSettings } from '../../islands/PlayerSettings.tsx'
import Base from '../../layouts/Base.astro'
import { createRichTranslator } from '@fenaki/i18n'
import { localeFrom, paths, translator } from '../../lib/i18n.ts'

const locale = localeFrom(Astro.params.locale)
if (!locale) return Astro.rewrite('/404')

const t = translator(locale)
// Signed in, the choice is the account's (every device); otherwise this browser's.
const savedIn = Astro.locals.member ? 'account' : 'browser'
const more = createRichTranslator(locale)('playerSettings.more', { cookies: 'link' as const })
---

<Base locale={locale} title={t('playerSettings.title')} noindex>
  <section class="grid gap-6 max-w-article">
    <h1 class="m-0 font-display text-display-l uppercase">{t('playerSettings.title')}</h1>
    <div class="grid gap-3 max-w-player-text text-body text-secondary">
      <p class="m-0">{t('playerSettings.intro')}</p>
      <p class="m-0">{t(`playerSettings.savedIn.${savedIn}`)}</p>
    </div>
    <PlayerSettings client:load locale={locale} />
    <p class="m-0 text-small text-secondary">
      {more.map((piece) =>
        piece === 'link' ? (
          <a
            class="text-primary underline underline-offset-4 hover:no-underline"
            href={paths.legal(locale, 'cookies')}
          >
            {t('playerSettings.cookiesLink')}
          </a>
        ) : (
          piece
        ),
      )}
    </p>
  </section>
</Base>
