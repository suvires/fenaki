---
import { Prose } from '@fenaki/ui'
import { PlayerSettings } from '../../islands/PlayerSettings.tsx'
import TextPage from '../../layouts/TextPage.astro'
import { createRichTranslator } from '@fenaki/i18n'
import { localeFrom, paths, translator } from '../../lib/i18n.ts'

const locale = localeFrom(Astro.params.locale)
if (!locale) return Astro.rewrite('/404')

const t = translator(locale)
// Signed in, the choice is the account's (every device); otherwise this browser's, unsaid here.
const signedIn = Boolean(Astro.locals.member)
const more = createRichTranslator(locale)('playerSettings.more', { cookies: 'link' as const })
---

<TextPage locale={locale} title={t('playerSettings.title')} noindex>
  <Prose>
    <h1>{t('playerSettings.title')}</h1>
    <p>{t('playerSettings.intro')}</p>
    {signedIn && <p>{t('playerSettings.savedInAccount')}</p>}
    <p>
      {more.map((piece) =>
        piece === 'link' ? (
          <a href={paths.legal(locale, 'cookies')}>{t('playerSettings.cookiesLink')}</a>
        ) : (
          piece
        ),
      )}
    </p>
  </Prose>
  <PlayerSettings client:load locale={locale} />
</TextPage>
