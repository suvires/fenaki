---
import { PageHeader, Pagination } from '@fenaki/ui'
import { HistoryGrid } from '../../islands/account/HistoryGrid.tsx'
import Base from '../../layouts/Base.astro'
import { loadViewings } from '../../lib/account/data.ts'
import { signInUrl } from '../../lib/account/rules.ts'
import { toCard } from '../../lib/catalog.ts'
import { listShortsBySlugs, toCardSource } from '../../lib/cms.ts'
import { localeFrom, paths, translator } from '../../lib/i18n.ts'
import { pageHref, pageOf, paginationProps, parsePage } from '../../lib/paging.ts'

const locale = localeFrom(Astro.params.locale)
if (!locale) return Astro.rewrite('/404')

const member = Astro.locals.member
if (!member) return Astro.redirect(signInUrl(paths.signIn(locale), Astro.url.pathname))

const t = translator(locale)
const base = paths.history(locale)
// Everything watched, newest first, 20 a page; only this page's shorts are read. A short no longer
// published has no page to link to: loadViewings already leaves it out.
const requested = parsePage(Astro.url.searchParams)
const { items: viewings, page, pages } = pageOf(await loadViewings(member, locale), requested)
if (requested > pages) return Astro.redirect(pageHref(base, pages), 302)
const shorts = await listShortsBySlugs(
  locale,
  viewings.map((viewing) => viewing.slug),
)
const bySlug = new Map(shorts.map((short) => [short.slug, short]))
const items = viewings.flatMap((viewing) => {
  const short = bySlug.get(viewing.slug)
  if (!short) return []
  const progress = viewing.completed ? 1 : Math.min(1, viewing.position / viewing.duration)
  return [
    {
      ...toCard(toCardSource(short), locale, t, paths.short(locale, short.slug)),
      slug: short.slug,
      progress,
      progressLabel: t('short.progress', { percent: Math.round(progress * 100) }),
    },
  ]
})
---

<Base locale={locale} title={t('account.history.title')} noindex>
  <div class="grid gap-8">
    <PageHeader title={t('account.history.title')} />
    <HistoryGrid client:load locale={locale} items={items} />
    {pages > 1 && <Pagination {...paginationProps(t, page, pages, (n) => pageHref(base, n))} />}
  </div>
</Base>
