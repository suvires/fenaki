---
import { badgeClock } from '../../../lib/services.ts'
import { ShortGrid, SponsorCredit } from '@fenaki/ui'
import NotFound from '../../../components/NotFound.astro'
import Base from '../../../layouts/Base.astro'
import { toCard } from '../../../lib/catalog.ts'
import { getCollection, shortsOf, sponsorOf, toCardSource } from '../../../lib/cms.ts'
import { sponsorCredit } from '../../../lib/analytics.ts'
import { localeFrom, paths, translator } from '../../../lib/i18n.ts'
import { collectionPage } from '../../../lib/seo.ts'
import { siteUrl } from '../../../lib/services.ts'

const locale = localeFrom(Astro.params.locale)
if (!locale) return Astro.rewrite('/404')

const t = translator(locale)
const collection = Astro.params.slug ? await getCollection(locale, Astro.params.slug) : undefined
if (!collection) Astro.response.status = 404
const shorts = collection ? shortsOf(collection) : []
const sponsor = collection ? sponsorOf(collection) : undefined
const clock = badgeClock()
const jsonLd = collection
  ? collectionPage(siteUrl, {
      name: collection.title,
      description: collection.description,
      url: paths.collection(locale, collection.slug),
      items: shorts.map((s) => ({ name: s.title, url: paths.short(locale, s.slug) })),
    })
  : undefined
---

<Base
  locale={locale}
  title={collection?.title ?? t('errors.notFoundTitle')}
  description={collection?.description ?? undefined}
  ogImage={collection ? paths.og(locale, 'colecciones', collection.slug) : undefined}
  jsonLd={jsonLd}
>
  {!collection ? (
    <NotFound locale={locale} />
  ) : (
    <>
      <header
        class:list={[
          'grid gap-4 p-6 md:p-8 rounded-lg',
          sponsor ? 'bg-sponsored text-on-sponsored' : 'bg-raised',
        ]}
      >
        <p
          class:list={[
            'm-0 font-mono text-label uppercase',
            sponsor ? 'text-on-sponsored' : 'text-accent',
          ]}
        >
          {t('collection.eyebrow', { count: shorts.length })}
        </p>
        <h1 class="m-0 font-display text-display-l md:text-display-xl uppercase text-balance">
          {collection.title}
        </h1>
        {collection.description && (
          <p
            class:list={[
              'm-0 max-w-hero-text text-body-l',
              sponsor ? 'text-on-sponsored' : 'text-secondary',
            ]}
          >
            {collection.description}
          </p>
        )}
        {sponsor && (
          <SponsorCredit
            {...sponsorCredit(sponsor, t('collection.sponsoredBy'), collection.slug)}
          />
        )}
      </header>
      <ShortGrid
        items={shorts.map((short) =>
          toCard(toCardSource(short), locale, t, paths.short(locale, short.slug), clock),
        )}
      />
    </>
  )}
</Base>
