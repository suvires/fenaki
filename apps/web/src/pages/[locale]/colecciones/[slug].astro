---
import { Pagination, ShortGrid, SponsorCredit } from '@fenaki/ui'
import NotFound from '../../../components/NotFound.astro'
import Base from '../../../layouts/Base.astro'
import { toCard } from '../../../lib/catalog.ts'
import { sponsorLogoUrl } from '../../../lib/cms.ts'
import { sponsorCredit } from '../../../lib/analytics.ts'
import { activeSponsorOf, collectionCards, findCollection } from '../../../lib/collections.ts'
import { localeFrom, paths, translator } from '../../../lib/i18n.ts'
import { PAGE_SIZE, pageCount, pageHref, paginationProps, parsePage } from '../../../lib/paging.ts'
import { collectionPage } from '../../../lib/seo.ts'
import { siteUrl } from '../../../lib/services.ts'

const locale = localeFrom(Astro.params.locale)
if (!locale) return Astro.rewrite('/404')

const t = translator(locale)
// FENAKI's collections and the sponsored ones share this address.
const collection = Astro.params.slug ? await findCollection(locale, Astro.params.slug) : undefined
if (!collection) Astro.response.status = 404
const base = collection ? paths.collection(locale, collection.doc.slug) : ''
const requested = parsePage(Astro.url.searchParams)
const { cards, total } = collection
  ? await collectionCards(locale, collection, (requested - 1) * PAGE_SIZE, PAGE_SIZE)
  : { cards: [], total: 0 }
const pages = pageCount(total)
if (collection && requested > pages) return Astro.redirect(pageHref(base, pages), 302)
const sponsor = collection ? activeSponsorOf(collection) : undefined
const doc = collection?.doc
const jsonLd = doc
  ? collectionPage(siteUrl, {
      name: doc.title,
      description: doc.description,
      url: base,
      items: cards.map((card) => ({ name: card.title, url: paths.short(locale, card.slug) })),
    })
  : undefined
---

<Base
  locale={locale}
  title={doc?.title ?? t('errors.notFoundTitle')}
  description={doc?.description ?? undefined}
  ogImage={doc ? paths.og(locale, 'colecciones', doc.slug) : undefined}
  jsonLd={jsonLd}
  noindex={requested > 1}
>
  {!doc ? (
    <NotFound locale={locale} />
  ) : (
    <>
      <header
        class:list={[
          'grid gap-4 p-6 md:p-8 rounded-lg',
          sponsor ? 'bg-sponsored text-on-sponsored' : 'bg-raised',
        ]}
      >
        <p
          class:list={[
            'm-0 font-mono text-label uppercase',
            sponsor ? 'text-on-sponsored' : 'text-accent',
          ]}
        >
          {t('collection.eyebrow', { count: total })}
        </p>
        <h1 class="m-0 font-display text-display-l md:text-display-xl uppercase text-balance">
          {doc.title}
        </h1>
        {doc.description && (
          <p
            class:list={[
              'm-0 max-w-hero-text text-body-l',
              sponsor ? 'text-on-sponsored' : 'text-secondary',
            ]}
          >
            {doc.description}
          </p>
        )}
        {sponsor && (
          <SponsorCredit
            {...sponsorCredit(
              sponsor,
              t('collection.sponsoredBy'),
              doc.slug,
              sponsorLogoUrl(sponsor),
            )}
          />
        )}
      </header>
      <ShortGrid
        items={cards.map((card) => toCard(card, locale, t, paths.short(locale, card.slug)))}
      />
      {pages > 1 && (
        <Pagination
          {...paginationProps(t, Math.min(requested, pages), pages, (n) => pageHref(base, n))}
        />
      )}
    </>
  )}
</Base>
