---
import { TOP10_PREVIEW } from 'astro:env/server'
import { CollectionHero, Rail, RankedItem, RankedRail, ShortCard, ShortHero } from '@fenaki/ui'
import { formatList, formatYear } from '@fenaki/i18n'
import Landing from '../../components/Landing.astro'
import { MyListButton } from '../../islands/MyListButton.tsx'
import { loadAccountState, loadViewings } from '../../lib/account/data.ts'
import { MyListRail } from '../../islands/MyListRail.tsx'
import Base from '../../layouts/Base.astro'
import { posterTone, toCard, toCurrentShort, toSavedShort } from '../../lib/catalog.ts'
import {
  getHeroShort,
  getRanking,
  listCollections,
  listShorts,
  peopleOf,
  shortsOf,
  sponsorOf,
  stillPresentationOf,
  stillUrlOf,
  toCardSource,
} from '../../lib/cms.ts'
import { sponsorCredit } from '../../lib/analytics.ts'
import { localeFrom, paths, translator } from '../../lib/i18n.ts'
import { previewEnabled, topTen } from '../../lib/ranking.ts'
import { badgeClock, siteMode } from '../../lib/services.ts'
import type { PublishedShort } from '../../lib/cms.ts'

const locale = localeFrom(Astro.params.locale)
if (!locale) return Astro.rewrite('/404')

const t = translator(locale)
const landing = siteMode === 'landing'
const clock = badgeClock()
// A signed-in viewer's list, ratings and unfinished viewings come from the account, rendered here.
const member = landing ? undefined : Astro.locals.member
const [account, unfinished] = member
  ? await Promise.all([
      loadAccountState(member, locale).catch(() => undefined),
      loadViewings(member, locale, { unfinished: true, limit: 20 }).catch(() => []),
    ])
  : [undefined, []]
const [shorts, collections] = landing
  ? [[], []]
  : await Promise.all([listShorts(locale), listCollections(locale)])

// «Lo más visto»: only a real ranking of ten (or the development preview).
const top = landing
  ? []
  : topTen({
      ranked: await getRanking(locale),
      latest: shorts,
      preview: previewEnabled(TOP10_PREVIEW, import.meta.env.PROD),
    })

// The hero: the short chosen in the admin panel (Portada), or else the latest one.
const hero = (landing ? undefined : await getHeroShort(locale)) ?? shorts[0]
const heroDirectors = hero ? peopleOf(hero, 'director') : []
const heroBackdrop = hero ? stillUrlOf(hero) : undefined
const heroStill = hero ? stillPresentationOf(hero) : undefined

const featured = collections.find((c) => c.featured) ?? collections[0]
const featuredShorts = featured ? shortsOf(featured) : []
const sponsor = featured ? sponsorOf(featured) : undefined

const rails: { key: string; title: string; href?: string; shorts: PublishedShort[] }[] = [
  { key: 'latest', title: t('home.rails.latest'), href: paths.latest(locale), shorts },
  {
    key: 'animation',
    title: t('home.rails.animation'),
    shorts: shorts.filter((s) => s.type === 'animation'),
  },
  ...collections
    .filter((c) => c !== featured)
    .map((c) => ({
      key: `c-${c.id}`,
      title: c.title,
      href: paths.collection(locale, c.slug),
      shorts: shortsOf(c),
    })),
].filter((rail) => rail.shorts.length > 0)
// «Seguir viendo»: the unfinished viewings that are still published, newest first.
const continueWatching = unfinished.flatMap((viewing) => {
  const short = shorts.find((s) => s.slug === viewing.slug)
  return short && viewing.duration > 0
    ? [{ short, progress: Math.min(1, viewing.position / viewing.duration) }]
    : []
})
// «Novedades» goes right under the hero and «Mi lista», above the featured collection.
const latestRails = rails.filter((rail) => rail.key === 'latest')
const otherRails = rails.filter((rail) => rail.key !== 'latest')
---

<Base locale={locale} glow={!landing} backdrop={landing} home>
  {landing && <Landing locale={locale} />}
  {!landing && hero && (
    // The light at the top of the page ends at this element's bottom edge (see Base.astro).
    <div data-glow-end>
      <ShortHero
        title={hero.title}
        seconds={hero.durationSeconds}
        locale={locale}
        details={[
          ...(heroDirectors.length > 0 ? [formatList(heroDirectors, locale)] : []),
          ...(hero.year ? [formatYear(hero.year, locale)] : []),
          t(`short.types.${hero.type}`),
        ]}
        synopsis={hero.synopsis ?? undefined}
        ctaLabel={t('home.hero.cta')}
        ctaHref={paths.short(locale, hero.slug)}
        poster={{
          title: hero.title,
          director: heroDirectors.join(', '),
          year: hero.year ?? undefined,
          tone: posterTone(hero.posterTone),
        }}
        backdrop={heroBackdrop}
        backdropTextColor={heroStill?.textColor}
        backdropHasTitle={heroStill?.includesTitle}
      >
        <MyListButton
          slot="secondaryAction"
          client:load
          size="lg"
          short={toSavedShort(toCardSource(hero), locale)}
          label={t('short.addToList')}
          savedLabel={t('short.inMyList')}
          initialSaved={account?.list.some((entry) => entry.slug === hero.slug)}
        />
      </ShortHero>
    </div>
  )}
  {/* «Seguir viendo»: only for a signed-in viewer, and only while something is unfinished. */}
  {continueWatching.length > 0 && (
    <Rail
      arrows={{ previous: t('rail.previous'), next: t('rail.next') }}
      title={t('home.continueWatching.title')}
    >
      {continueWatching.map(({ short, progress }) => (
        <ShortCard
          {...toCard(toCardSource(short), locale, t, paths.short(locale, short.slug), clock)}
          progress={progress}
          progressLabel={t('short.progress', { percent: Math.round(progress * 100) })}
        />
      ))}
    </Rail>
  )}
  {/* Renders nothing until the viewer has saved something. */}
  {!landing && (
    <MyListRail
      client:load
      title={t('home.myList.title')}
      actionLabel={t('rail.seeAll')}
      actionHref={paths.myList(locale)}
      arrows={{ previous: t('rail.previous'), next: t('rail.next') }}
      locale={locale}
      hrefBase={paths.short(locale, '')}
      initial={account?.list}
      current={Object.fromEntries(
        shorts.map((s) => [s.slug, toCurrentShort(toCardSource(s), locale, t, clock)]),
      )}
    />
  )}
  {!landing && shorts.length === 0 && (
    <p class="m-0 text-body-l text-ink-muted">{t('home.empty')}</p>
  )}
  {!landing &&
    latestRails.map((rail) => (
      <div>
        <Rail
          arrows={{ previous: t('rail.previous'), next: t('rail.next') }}
          title={rail.title}
          actionLabel={rail.href ? t('rail.seeAll') : undefined}
          actionHref={rail.href}
        >
          {rail.shorts.map((short) => {
            const card = toCardSource(short)
            return (
              <ShortCard {...toCard(card, locale, t, paths.short(locale, short.slug), clock)} />
            )
          })}
        </Rail>
      </div>
    ))}
  {!landing && featured && (
    <CollectionHero
      headingLevel={hero ? 2 : 1}
      title={featured.title}
      description={featured.description ?? ''}
      ctaLabel={t('collection.cta')}
      ctaHref={paths.collection(locale, featured.slug)}
      sponsor={
        sponsor ? sponsorCredit(sponsor, t('collection.sponsoredBy'), featured.slug) : undefined
      }
      posters={featuredShorts.slice(0, 3).map((s) => ({
        title: s.title,
        director: peopleOf(s, 'director').join(', '),
        year: s.year ?? undefined,
        tone: posterTone(s.posterTone),
      }))}
    />
  )}
  {top.length > 0 && (
    <RankedRail
      arrows={{ previous: t('rail.previous'), next: t('rail.next') }}
      title={t('home.top10.title')}
    >
      {top.map((short, index) => (
        <RankedItem rank={index + 1} rankLabel={t('home.top10.rank', { rank: index + 1 })}>
          <ShortCard
            {...toCard(toCardSource(short), locale, t, paths.short(locale, short.slug), clock)}
          />
        </RankedItem>
      ))}
    </RankedRail>
  )}
  {!landing &&
    otherRails.map((rail) => (
      <div>
        <Rail
          arrows={{ previous: t('rail.previous'), next: t('rail.next') }}
          title={rail.title}
          actionLabel={rail.href ? t('rail.seeAll') : undefined}
          actionHref={rail.href}
        >
          {rail.shorts.map((short) => {
            const card = toCardSource(short)
            return (
              <ShortCard {...toCard(card, locale, t, paths.short(locale, short.slug), clock)} />
            )
          })}
        </Rail>
      </div>
    ))}
</Base>
