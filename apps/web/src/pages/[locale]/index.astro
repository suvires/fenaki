---
import { TOP10_PREVIEW } from 'astro:env/server'
import {
  CollectionHero,
  Rail,
  RankedItem,
  RankedRail,
  ShortCard,
  ShortHero,
  TopicCard,
} from '@fenaki/ui'
import { formatList, formatYear } from '@fenaki/i18n'
import Landing from '../../components/Landing.astro'
import { MyListButton } from '../../islands/MyListButton.tsx'
import { loadAccountState, loadViewings } from '../../lib/account/data.ts'
import { MyListRail } from '../../islands/MyListRail.tsx'
import Base from '../../layouts/Base.astro'
import { badgesFor, posterTone, toCard, toCurrentShort, toSavedShort } from '../../lib/catalog.ts'
import {
  getHeroShort,
  getRanking,
  listShorts,
  listShortsBySlugs,
  peopleOf,
  sponsorLogoUrl,
  stillPresentationOf,
  stillUrlOf,
  toCardSource,
} from '../../lib/cms.ts'
import { sponsorCredit } from '../../lib/analytics.ts'
import { activeSponsorOf, homeCollections } from '../../lib/collections.ts'
import { localeFrom, paths, translator } from '../../lib/i18n.ts'
import { PAGE_SIZE } from '../../lib/paging.ts'
import { previewEnabled, topTen } from '../../lib/ranking.ts'
import { themeCounts } from '../../lib/search.ts'
import { siteMode } from '../../lib/services.ts'
import { THEMES, topicHref, topicTone } from '../../lib/topics.ts'
import type { CardSource } from '../../lib/catalog.ts'

const locale = localeFrom(Astro.params.locale)
if (!locale) return Astro.rewrite('/404')

const t = translator(locale)
const landing = siteMode === 'landing'
// A signed-in viewer's list, ratings and unfinished viewings come from the account, rendered here.
const member = landing ? undefined : Astro.locals.member
const [account, unfinished] = member
  ? await Promise.all([
      loadAccountState(member, locale).catch(() => undefined),
      loadViewings(member, locale, { unfinished: true, limit: 20 }).catch(() => []),
    ])
  : [undefined, []]
const [shorts, collections, savedShorts, topicCounts] = landing
  ? [[], { rails: [] }, [], undefined]
  : await Promise.all([
      listShorts(locale),
      homeCollections(locale),
      // «Mi lista»'s rail: the current data of the account's 20 latest saved shorts.
      listShortsBySlugs(
        locale,
        (account?.list ?? []).slice(0, PAGE_SIZE).map((entry) => entry.slug),
      ),
      // «Explora por tema»: without the search engine the row just goes.
      themeCounts(locale).catch(() => undefined),
    ])

// «Lo más visto»: only a real ranking of ten (or the development preview).
const top = landing
  ? []
  : topTen({
      ranked: await getRanking(locale),
      latest: shorts,
      preview: previewEnabled(TOP10_PREVIEW, import.meta.env.PROD),
    })

// The hero: the short chosen in the admin panel (Portada), or else the latest one.
const hero = (landing ? undefined : await getHeroShort(locale)) ?? shorts[0]
const heroDirectors = hero ? peopleOf(hero, 'director') : []
const heroBackdrop = hero ? stillUrlOf(hero) : undefined
const heroStill = hero ? stillPresentationOf(hero) : undefined

// The featured collection (the hero further down) and the rails of the others, of both kinds.
const featured = collections.featured
const sponsor = featured ? activeSponsorOf(featured.collection) : undefined

const rails: { key: string; title: string; href?: string; cards: CardSource[] }[] = [
  {
    key: 'latest',
    title: t('home.rails.latest'),
    href: paths.latest(locale),
    cards: shorts.map(toCardSource),
  },
  {
    key: 'animation',
    title: t('home.rails.animation'),
    cards: shorts.filter((s) => s.type === 'animation').map(toCardSource),
  },
  ...collections.rails.map(({ collection, cards }) => ({
    key: `${collection.kind}-${collection.doc.id}`,
    title: collection.doc.title,
    href: paths.collection(locale, collection.doc.slug),
    cards,
  })),
].filter((rail) => rail.cards.length > 0)
// «Seguir viendo»: the unfinished viewings that are still published, newest first.
const continueWatching = unfinished.flatMap((viewing) => {
  const short = shorts.find((s) => s.slug === viewing.slug)
  return short && viewing.duration > 0
    ? [{ short, progress: Math.min(1, viewing.position / viewing.duration) }]
    : []
})
// «Novedades» goes right under the hero and «Mi lista», above the featured collection.
const latestRails = rails.filter((rail) => rail.key === 'latest')
const otherRails = rails.filter((rail) => rail.key !== 'latest')
---

<Base locale={locale} glow={!landing} backdrop={landing} home>
  {landing && <Landing locale={locale} />}
  {!landing && hero && (
    // The light at the top of the page ends at this element's bottom edge (see Base.astro).
    <div data-glow-end>
      <ShortHero
        title={hero.title}
        seconds={hero.durationSeconds}
        locale={locale}
        details={[
          ...(heroDirectors.length > 0 ? [formatList(heroDirectors, locale)] : []),
          ...(hero.year ? [formatYear(hero.year, locale)] : []),
          t(`short.types.${hero.type}`),
        ]}
        badges={badgesFor(toCardSource(hero), t)}
        synopsis={hero.synopsis ?? undefined}
        ctaLabel={t('home.hero.cta')}
        ctaHref={paths.play(locale, hero.slug)}
        poster={{
          title: hero.title,
          director: heroDirectors.join(', '),
          year: hero.year ?? undefined,
          tone: posterTone(hero.posterTone),
        }}
        backdrop={heroBackdrop}
        backdropTextColor={heroStill?.textColor}
        backdropHasTitle={heroStill?.includesTitle}
      >
        <MyListButton
          slot="secondaryAction"
          client:load
          size="lg"
          short={toSavedShort(toCardSource(hero), locale)}
          label={t('short.addToList')}
          savedLabel={t('short.inMyList')}
          initialSaved={account?.list.some((entry) => entry.slug === hero.slug)}
        />
      </ShortHero>
    </div>
  )}
  {/* «Seguir viendo»: only for a signed-in viewer, and only while something is unfinished. */}
  {continueWatching.length > 0 && (
    <div data-continue-watching>
      <Rail
        arrows={{ previous: t('rail.previous'), next: t('rail.next') }}
        title={t('home.continueWatching.title')}
      >
        {continueWatching.map(({ short, progress }) => (
          <ShortCard
            {...toCard(toCardSource(short), locale, t, paths.short(locale, short.slug))}
            progress={progress}
            progressLabel={t('short.progress', { percent: Math.round(progress * 100) })}
            removableFrom="continueWatching"
          />
        ))}
      </Rail>
    </div>
  )}
  {/* Renders nothing until the viewer has saved something. */}
  {!landing && (
    <MyListRail
      client:load
      title={t('home.myList.title')}
      actionLabel={t('rail.seeAll')}
      actionHref={paths.myList(locale)}
      arrows={{ previous: t('rail.previous'), next: t('rail.next') }}
      locale={locale}
      hrefBase={paths.short(locale, '')}
      initial={account?.list}
      current={Object.fromEntries(
        savedShorts.map((s) => [s.slug, toCurrentShort(toCardSource(s), locale, t)]),
      )}
    />
  )}
  {!landing && shorts.length === 0 && (
    <p class="m-0 text-body-l text-secondary">{t('home.empty')}</p>
  )}
  {!landing &&
    latestRails.map((rail) => (
      <div>
        <Rail
          arrows={{ previous: t('rail.previous'), next: t('rail.next') }}
          title={rail.title}
          actionLabel={rail.href ? t('rail.seeAll') : undefined}
          actionHref={rail.href}
        >
          {rail.cards.map((card) => (
            <ShortCard {...toCard(card, locale, t, paths.short(locale, card.slug))} />
          ))}
        </Rail>
      </div>
    ))}
  {!landing && featured && (
    <CollectionHero
      headingLevel={hero ? 2 : 1}
      title={featured.collection.doc.title}
      description={featured.collection.doc.description ?? ''}
      ctaLabel={t('collection.cta')}
      ctaHref={paths.collection(locale, featured.collection.doc.slug)}
      sponsor={
        sponsor
          ? sponsorCredit(
              sponsor,
              t('collection.sponsoredBy'),
              featured.collection.doc.slug,
              sponsorLogoUrl(sponsor),
            )
          : undefined
      }
      posters={featured.cards.slice(0, 3).map((card) => ({
        title: card.title,
        director: card.directors.join(', '),
        year: card.year ?? undefined,
        tone: posterTone(card.posterTone),
      }))}
    />
  )}
  {top.length > 0 && (
    <RankedRail
      arrows={{ previous: t('rail.previous'), next: t('rail.next') }}
      title={t('home.top10.title')}
    >
      {top.map((short, index) => (
        <RankedItem rank={index + 1} rankLabel={t('home.top10.rank', { rank: index + 1 })}>
          <ShortCard {...toCard(toCardSource(short), locale, t, paths.short(locale, short.slug))} />
        </RankedItem>
      ))}
    </RankedRail>
  )}
  {!landing && topicCounts && (
    <Rail
      arrows={{ previous: t('rail.previous'), next: t('rail.next') }}
      title={t('topics.heading')}
      actionLabel={t('topics.seeAll')}
      actionHref={paths.topics(locale)}
    >
      {THEMES.map((theme) => (
        <TopicCard
          tone={topicTone(theme)}
          title={t(`short.themes.${theme}`)}
          href={topicHref(locale, theme)}
          meta={topicCounts[theme] ? t('browse.count', { count: topicCounts[theme] }) : undefined}
        />
      ))}
    </Rail>
  )}
  {!landing &&
    otherRails.map((rail) => (
      <div>
        <Rail
          arrows={{ previous: t('rail.previous'), next: t('rail.next') }}
          title={rail.title}
          actionLabel={rail.href ? t('rail.seeAll') : undefined}
          actionHref={rail.href}
        >
          {rail.cards.map((card) => (
            <ShortCard {...toCard(card, locale, t, paths.short(locale, card.slug))} />
          ))}
        </Rail>
      </div>
    ))}
  <script>
    import { onRemovedFromHistory } from '../../lib/history.ts'

    // «Seguir viendo» is rendered here, not by an island: a short removed from the history (from
    // its preview) leaves the rail, and the rail goes once it is empty.
    onRemovedFromHistory((slug) => {
      const rail = document.querySelector('[data-continue-watching]')
      rail?.querySelector(`[data-short-card="${CSS.escape(slug)}"]`)?.remove()
      if (rail && !rail.querySelector('[data-short-card]')) rail.remove()
    })
  </script>
</Base>
