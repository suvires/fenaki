---
import { Button, Notice, Prose } from '@fenaki/ui'
import { SubmitShort } from '../../islands/SubmitShort.tsx'
import TextPage from '../../layouts/TextPage.astro'
import { localeFrom, paths, translator } from '../../lib/i18n.ts'

const locale = localeFrom(Astro.params.locale)
if (!locale) return Astro.rewrite('/404')

const t = translator(locale)
const member = Astro.locals.member
const requirements = (['video', 'rights', 'review'] as const).map((key) =>
  t(`submit.requirements.${key}`),
)
---

<TextPage
  locale={locale}
  title={t('submit.title')}
  lead={t('submit.description')}
  description={t('submit.description')}
>
  <Prose>
    <h2>{t('submit.requirements.title')}</h2>
    <ol>
      {requirements.map((requirement) => (
        <li>{requirement}</li>
      ))}
    </ol>
    {member && <h2>{t('submit.form.title')}</h2>}
  </Prose>
  {member ? (
    <SubmitShort
      client:load
      locale={locale}
      termsHref={paths.legal(locale, 'terminos-de-uso')}
      mySubmissionsHref={paths.mySubmissions(locale)}
    />
  ) : (
    <Notice title={t('submit.signedOut.title')}>
      <p class="m-0">{t('submit.signedOut.text')}</p>
      <div class="flex flex-wrap gap-3 pt-2">
        <Button href={paths.signIn(locale, paths.submit(locale))}>
          {t('submit.signedOut.signIn')}
        </Button>
        <Button variant="secondary" href={paths.signUp(locale)}>
          {t('submit.signedOut.signUp')}
        </Button>
      </div>
    </Notice>
  )}
</TextPage>
