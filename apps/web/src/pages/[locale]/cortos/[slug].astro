---
import {
  createRichTranslator,
  formatCountry,
  formatLanguage,
  formatList,
  formatListParts,
  formatYear,
} from '@fenaki/i18n'
import { Rail, ShareButton, ShortCard } from '@fenaki/ui'
import NotFound from '../../../components/NotFound.astro'
import PeopleLinks from '../../../components/PeopleLinks.astro'
import { MyListButton } from '../../../islands/MyListButton.tsx'
import { ShortPlayer } from '../../../islands/ShortPlayer.tsx'
import { loadAccountState, loadViewing } from '../../../lib/account/data.ts'
import Base from '../../../layouts/Base.astro'
import { badgesFor, posterTone, toCard, toSavedShort } from '../../../lib/catalog.ts'
import {
  creditsOf,
  getRelatedShorts,
  getShort,
  slugMovedTo,
  listShorts,
  listSources,
  playableSource,
  stillPresentationOf,
  stillUrlOf,
  toCardSource,
} from '../../../lib/cms.ts'
import { EVENTS, eventAttributes } from '../../../lib/analytics.ts'
import { embedPageUrl } from '../../../lib/embed.ts'
import { clock, resumable } from '../../../lib/playerProgress.ts'
import { videoObject } from '../../../lib/seo.ts'
import { siteUrl } from '../../../lib/services.ts'
import { shareTargets } from '../../../lib/share.ts'
import { absoluteUrl } from '../../../lib/seo.ts'
import { localeFrom, paths, translator } from '../../../lib/i18n.ts'

const locale = localeFrom(Astro.params.locale)
if (!locale) return Astro.rewrite('/404')

const t = translator(locale)
const short = Astro.params.slug ? await getShort(locale, Astro.params.slug) : undefined
// An old address of a short (its title was cleaned and its slug with it) leads to the current one.
if (!short && Astro.params.slug) {
  const moved = await slugMovedTo(locale, Astro.params.slug)
  if (moved) return Astro.redirect(`${paths.short(locale, moved)}${Astro.url.search}`, 301)
}
if (!short) Astro.response.status = 404

// A signed-in viewer: what the account has of this short (saved, and where they stopped).
const member = Astro.locals.member
const [account, viewing] =
  member && short
    ? await Promise.all([
        loadAccountState(member, locale).catch(() => undefined),
        loadViewing(member, short.id).catch(() => undefined),
      ])
    : [undefined, undefined]
const resumeAt =
  viewing && !viewing.completed && resumable(viewing.position, viewing.duration)
    ? viewing.position
    : undefined
const source = short ? playableSource(await listSources(short.id)) : undefined
const provider = source ? t(`providers.${source.provider}`) : ''
const card = short ? toCardSource(short) : undefined
const directors = short ? creditsOf(short, 'director') : []
const still = short ? stillPresentationOf(short) : undefined

const ROLES = ['writer', 'producer', 'cinematographer', 'editor', 'composer', 'cast'] as const
// Newest ceremony first.
const awards = [...(short?.awards ?? [])].sort((a, b) => (b.year ?? 0) - (a.year ?? 0))
const credits = short
  ? ROLES.map((role) => ({ role, people: creditsOf(short, role) })).filter(
      (c) => c.people.length > 0,
    )
  : []

const related = short
  ? await getRelatedShorts(locale, short.id).catch(async () =>
      // Without the CMS's scoring, the latest shorts of the same type.
      (await listShorts(locale, 24))
        .filter((s) => s.id !== short.id)
        .sort((a, b) => Number(b.type === short.type) - Number(a.type === short.type))
        .slice(0, 12),
    )
  : []

const jsonLd = short
  ? videoObject(siteUrl, {
      name: short.title,
      description: short.synopsis,
      url: paths.short(locale, short.slug),
      thumbnailUrl: paths.og(locale, 'cortos', short.slug),
      uploadDate: source?.uploadedAt ?? short.publishedAt,
      durationSeconds: short.durationSeconds,
      embedUrl:
        source && !short.sample ? embedPageUrl(source.provider, source.externalId) : undefined,
      inLanguage: short.originalLanguage,
      countryOfOrigin: short.country ? formatCountry(short.country, locale) : undefined,
      year: short.year,
      genre: t(`short.types.${short.type}`),
      directors: directors.map((d) => ({ name: d.name, url: paths.person(locale, d.slug) })),
    })
  : undefined

// Sharing: the page's address on the public site, and one link per network or messaging app.
const shareUrl = short ? absoluteUrl(siteUrl, paths.short(locale, short.slug)) : ''
const shareText = short ? t('short.share.text', { title: short.title }) : ''
const share = short
  ? shareTargets(
      shareUrl,
      shareText,
      (network) => t(`short.share.networks.${network}`),
      (network) => eventAttributes(EVENTS.share, { short: short.slug, network }),
    )
  : []

// The hero's details line: year, country and type; the badges follow it. The directors go on a
// line of their own, «Dirigido por …», as in the preview, each linked to their page.
const details = short
  ? [
      ...(short.year ? [formatYear(short.year, locale)] : []),
      ...(short.country ? [formatCountry(short.country, locale)] : []),
      t(`short.types.${short.type}`),
    ]
  : []

const directorLinks = Object.fromEntries(
  directors.map((d) => [d.name, { label: d.name, href: paths.person(locale, d.slug) }]),
)
const directedBy =
  directors.length > 0
    ? createRichTranslator(locale)('short.directedBy', { names: 'names' as const }).flatMap(
        (piece) =>
          piece === 'names'
            ? formatListParts(
                directors.map((d) => d.name),
                locale,
              ).map((part) =>
                part.type === 'element' ? (directorLinks[part.value] ?? part.value) : part.value,
              )
            : [piece],
      )
    : undefined

// «Idioma y subtítulos»: the spoken language, and the subtitles its official player offers, the
// viewer's language first. Intl writes language names in lowercase: a value starts with a capital.
const capital = (text: string) => text.charAt(0).toLocaleUpperCase(locale) + text.slice(1)
const spoken = short?.noDialogue
  ? t('badges.noDialogue')
  : short?.originalLanguage
    ? capital(formatLanguage(short.originalLanguage, locale))
    : undefined
// «Ficha técnica»: the original title, the production and the channel that publishes the source
// the page plays (a festival, a school, its makers).
const channel = source?.channel
const sheet = short
  ? [
      ...(short.originalTitle
        ? [{ term: t('short.sheet.originalTitle'), value: short.originalTitle }]
        : []),
      ...(short.production ? [{ term: t('short.sheet.production'), value: short.production }] : []),
      ...(channel?.name
        ? [
            {
              term: t('short.sheet.publishedBy'),
              value: channel.name,
              href: channel.url ?? undefined,
            },
          ]
        : []),
    ]
  : []
const subtitles = [...(card?.subtitles ?? [])]
  .sort((a, b) => Number(b === locale) - Number(a === locale))
  .map((code) => formatLanguage(code, locale))
---

<Base
  locale={locale}
  title={short?.title ?? t('errors.notFoundTitle')}
  description={short?.synopsis ?? undefined}
  ogType={short ? 'video.other' : undefined}
  ogImage={short ? paths.og(locale, 'cortos', short.slug) : undefined}
  jsonLd={jsonLd}
>
  {!short || !card ? (
    <NotFound locale={locale} />
  ) : (
    <article class="grid gap-8">
      <ShortPlayer
        client:visible
        locale={locale}
        slug={short.slug}
        provider={source?.provider}
        title={short.title}
        playLabel={t('short.player.play')}
        loadedLabel={
          short.sample ? t('short.player.sample') : t('short.player.loaded', { provider })
        }
        source={
          source && !short.sample
            ? { provider: source.provider, externalId: source.externalId }
            : undefined
        }
        embedTitle={t('short.player.frameTitle', { provider, title: short.title })}
        playAttributes={eventAttributes(EVENTS.play, {
          short: short.slug,
          ...(source ? { provider: source.provider } : {}),
        })}
        tracking={Boolean(member)}
        resume={
          resumeAt === undefined
            ? undefined
            : {
                seconds: resumeAt,
                label: t('short.player.resume', { time: clock(resumeAt, locale) }),
                startOverLabel: t('short.player.startOver'),
              }
        }
        hero={{
          badges: card ? badgesFor(card, t) : [],
          directedBy,
          seconds: short.durationSeconds,
          locale,
          details,
          synopsis: short.synopsis ?? undefined,
          clampSynopsis: false,
          poster: {
            title: short.title,
            director: directors.map((d) => d.name).join(', '),
            year: short.year ?? undefined,
            tone: posterTone(short.posterTone),
          },
          backdrop: stillUrlOf(short),
          backdropTextColor: still?.textColor,
          backdropHasTitle: still?.includesTitle,
        }}
      >
        <MyListButton
          slot="secondaryAction"
          client:load
          size="lg"
          display="auto"
          short={toSavedShort(card, locale)}
          label={t('short.addToList')}
          savedLabel={t('short.inMyList')}
          removeLabel={t('short.removeFromList')}
          initialSaved={account?.list.some((entry) => entry.slug === short.slug)}
        />
        <ShareButton
          slot="secondaryAction"
          client:idle
          display="auto"
          label={t('short.share.label')}
          url={shareUrl}
          title={short.title}
          text={shareText}
          targets={share}
          dialogTitle={t('short.share.dialogTitle', { title: short.title })}
          copyLabel={t('short.share.copy')}
          copiedLabel={t('short.share.copied')}
          moreLabel={t('short.share.more')}
          closeLabel={t('short.share.close')}
        />
      </ShortPlayer>
      <div class="grid gap-8 max-w-article empty:hidden">
        {awards.length > 0 && (
          <section class="grid gap-2" aria-labelledby="awards">
            <h2 id="awards" class="m-0 font-display text-title uppercase">
              {t('short.awards')}
            </h2>
            <ul class="m-0 p-0 list-none grid gap-2 text-body">
              {awards.map((award) => (
                <li class="grid">
                  <span>{award.name}</span>
                  <span class="text-meta text-secondary">
                    {[
                      t(`short.awardResults.${award.result}`),
                      award.year && formatYear(award.year, locale),
                    ]
                      .filter(Boolean)
                      .join(' · ')}
                  </span>
                </li>
              ))}
            </ul>
          </section>
        )}
        {(spoken || subtitles.length > 0) && (
          <section class="grid gap-2" aria-labelledby="language">
            <h2 id="language" class="m-0 font-display text-title uppercase">
              {subtitles.length > 0 ? t('short.language.title') : t('short.language.only')}
            </h2>
            <dl class="m-0 grid grid-cols-[max-content_1fr] gap-x-4 gap-y-1 text-body">
              {spoken && (
                <>
                  <dt class="text-secondary">{t('short.language.spoken')}</dt>
                  <dd class="m-0">{spoken}</dd>
                </>
              )}
              {subtitles.length > 0 && (
                <>
                  <dt class="text-secondary">{t('short.language.subtitles')}</dt>
                  <dd class="m-0">{capital(formatList(subtitles, locale))}</dd>
                </>
              )}
            </dl>
          </section>
        )}
        {sheet.length > 0 && (
          <section class="grid gap-2" aria-labelledby="sheet">
            <h2 id="sheet" class="m-0 font-display text-title uppercase">
              {t('short.sheet.title')}
            </h2>
            <dl class="m-0 grid grid-cols-[max-content_1fr] gap-x-4 gap-y-1 text-body">
              {sheet.map((row) => (
                <>
                  <dt class="text-secondary">{row.term}</dt>
                  <dd class="m-0">
                    {row.href ? (
                      <a
                        href={row.href}
                        rel="noopener"
                        class="text-primary underline underline-offset-4 hover:no-underline rounded-xs focus-visible:focus-ring"
                      >
                        {row.value}
                      </a>
                    ) : (
                      row.value
                    )}
                  </dd>
                </>
              ))}
            </dl>
          </section>
        )}
        {credits.length > 0 && (
          <section class="grid gap-2" aria-labelledby="credits">
            <h2 id="credits" class="m-0 font-display text-title uppercase">
              {t('short.credits')}
            </h2>
            <dl class="m-0 grid grid-cols-[max-content_1fr] gap-x-4 gap-y-1 text-body">
              {credits.map((credit) => (
                <>
                  <dt class="text-secondary">{t(`short.roles.${credit.role}`)}</dt>
                  <dd class="m-0">
                    <PeopleLinks locale={locale} people={credit.people} />
                  </dd>
                </>
              ))}
            </dl>
          </section>
        )}
      </div>
      {related.length > 0 && (
        <Rail
          arrows={{ previous: t('rail.previous'), next: t('rail.next') }}
          title={t('short.related', { title: short.title })}
        >
          {related.map((s) => (
            <ShortCard {...toCard(toCardSource(s), locale, t, paths.short(locale, s.slug))} />
          ))}
        </Rail>
      )}
    </article>
  )}
</Base>
