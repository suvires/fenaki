---
import { formatCountry, formatLanguage, type MessageKey } from '@fenaki/i18n'
import { Button, FacetGroup, PageHeader, Pagination, ShortGrid, type FacetOption } from '@fenaki/ui'
import Base from '../../../layouts/Base.astro'
import {
  browseHref,
  FILTERS,
  hasFilters,
  parseBrowseParams,
  toggleHref,
  type FilterKey,
} from '../../../lib/browse.ts'
import { toCard } from '../../../lib/catalog.ts'
import { localeFrom, paths, translator } from '../../../lib/i18n.ts'
import { paginationProps } from '../../../lib/paging.ts'
import { browseShorts, type BrowseResult } from '../../../lib/search.ts'
import { collectionPage } from '../../../lib/seo.ts'
import { badgeClock, siteUrl } from '../../../lib/services.ts'

const locale = localeFrom(Astro.params.locale)
if (!locale) return Astro.rewrite('/404')

const t = translator(locale)
const base = paths.browse(locale)
const { filters, page } = parseBrowseParams(Astro.url.searchParams)

let result: BrowseResult | undefined
try {
  result = await browseShorts(locale, filters, page)
} catch {
  Astro.response.status = 503
}
if (result && page > result.pages) {
  return Astro.redirect(browseHref(base, filters, result.pages), 302)
}

const counts = (key: FilterKey) => result?.facets[FILTERS[key]] ?? {}
const option = (key: FilterKey, value: string, label: string): FacetOption => ({
  label,
  href: toggleHref(base, filters, key, value),
  count: counts(key)[value] ?? 0,
  selected: filters[key] === value,
})
/** Every value the index knows for a filter, most frequent first. */
const byCount = (key: FilterKey, label: (value: string) => string) =>
  Object.entries(counts(key))
    .sort(([a, x], [b, y]) => y - x || a.localeCompare(b))
    .map(([value]) => option(key, value, label(value)))

const groups: { key: FilterKey; label: string; options: FacetOption[] }[] = [
  {
    key: 'duration',
    label: t('browse.filters.duration'),
    options: (['short', 'mid', 'long'] as const).map((band) =>
      option('duration', band, t(`home.filters.${band}`)),
    ),
  },
  {
    key: 'lang',
    label: t('browse.filters.language'),
    options: byCount('lang', (code) =>
      code === 'zxx' ? t('browse.values.noDialogue') : formatLanguage(code, locale),
    ),
  },
  {
    key: 'subs',
    label: t('browse.filters.subtitles'),
    options: [option('subs', locale, t('browse.values.subtitlesEs'))],
  },
  {
    key: 'form',
    label: t('browse.filters.form'),
    options: [
      option('form', 'animation', t('browse.values.animation')),
      option('form', 'live-action', t('browse.values.liveAction')),
    ],
  },
  {
    key: 'type',
    label: t('browse.filters.type'),
    options: byCount('type', (type) => t(`short.types.${type}` as MessageKey)),
  },
  {
    key: 'genre',
    label: t('browse.filters.genre'),
    options: byCount('genre', (genre) => t(`short.genres.${genre}` as MessageKey)),
  },
  {
    key: 'theme',
    label: t('browse.filters.theme'),
    options: byCount('theme', (theme) => t(`short.themes.${theme}` as MessageKey)),
  },
  {
    key: 'audience',
    label: t('browse.filters.audience'),
    options: [option('audience', 'all', t('browse.values.allAudiences'))],
  },
  {
    key: 'country',
    label: t('browse.filters.country'),
    options: byCount('country', (code) => formatCountry(code, locale)),
  },
]

const filtered = hasFilters(filters)
const selectedLabels = groups.flatMap((g) =>
  g.options.filter((o) => o.selected).map((o) => o.label),
)
const clock = badgeClock()
const countLabel = (count: number) => t('browse.count', { count })
const jsonLd =
  result && !filtered && page === 1
    ? collectionPage(siteUrl, {
        name: t('browse.title'),
        description: t('browse.description'),
        url: base,
        items: result.hits.map((hit) => ({ name: hit.title, url: paths.short(locale, hit.slug) })),
      })
    : undefined
---

<Base
  locale={locale}
  title={
    filtered
      ? t('browse.filteredTitle', { filters: selectedLabels.join(' · ') })
      : t('browse.title')
  }
  description={t('browse.description')}
  noindex={filtered || page > 1}
  canonicalPath={base}
  ogImage={paths.ogPage(locale, 'browse')}
  jsonLd={jsonLd}
>
  <PageHeader
    eyebrow={result && !filtered ? t('browse.eyebrow', { count: result.total }) : undefined}
    title={t('browse.title')}
    description={t('browse.description')}
  />
  {!result ? (
    <p role="status" class="m-0 text-body-l text-secondary">
      {t('browse.unavailable')}
    </p>
  ) : (
    <>
      <section aria-label={t('browse.filtersLabel')} class="grid gap-4">
        {groups.map((group) => (
          <FacetGroup label={group.label} options={group.options} countLabel={countLabel} />
        ))}
      </section>
      <div class="grid gap-4">
        <div class="flex flex-wrap items-center gap-4">
          <p role="status" class="m-0 text-body text-secondary">
            {result.total === 0
              ? t('browse.empty')
              : filtered
                ? t('browse.results', { count: result.total })
                : t('browse.count', { count: result.total })}
          </p>
          {filtered && (
            <Button variant="ghost" href={base}>
              {t('browse.clear')}
            </Button>
          )}
        </div>
        {result.hits.length > 0 && (
          <ShortGrid
            items={result.hits.map((hit) =>
              toCard(hit, locale, t, paths.short(locale, hit.slug), clock),
            )}
          />
        )}
        {result.pages > 1 && (
          <Pagination
            {...paginationProps(t, page, result.pages, (n) => browseHref(base, filters, n))}
          />
        )}
      </div>
    </>
  )}
</Base>
