---
import { ShortGrid, ShowcaseHero } from '@fenaki/ui'
import NotFound from '../../../components/NotFound.astro'
import Base from '../../../layouts/Base.astro'
import { sponsorCredit } from '../../../lib/analytics.ts'
import { toCard } from '../../../lib/catalog.ts'
import { getShowcase, logoOf, presenterOf, shortsOf, toCardSource } from '../../../lib/cms.ts'
import { localeFrom, paths, translator } from '../../../lib/i18n.ts'
import { collectionPage } from '../../../lib/seo.ts'
import { badgeClock, siteUrl } from '../../../lib/services.ts'

const locale = localeFrom(Astro.params.locale)
if (!locale) return Astro.rewrite('/404')

const t = translator(locale)
const showcase = Astro.params.slug ? await getShowcase(locale, Astro.params.slug) : undefined
if (!showcase) Astro.response.status = 404
const shorts = showcase ? shortsOf(showcase) : []
const logo = showcase ? logoOf(showcase) : undefined
const presenter = showcase ? presenterOf(showcase) : undefined
const kind = showcase ? t(`showcase.kinds.${showcase.kind}`) : ''
const clock = badgeClock()
const description = showcase
  ? (showcase.intro ?? t(`showcase.description.${showcase.kind}`, { name: showcase.name }))
  : undefined

const jsonLd = showcase
  ? collectionPage(siteUrl, {
      name: showcase.name,
      description,
      url: paths.showcase(locale, showcase.slug),
      items: shorts.map((s) => ({ name: s.title, url: paths.short(locale, s.slug) })),
      about: {
        '@type': showcase.kind === 'festival' ? 'Festival' : 'Organization',
        name: showcase.name,
        ...(showcase.website ? { url: showcase.website } : {}),
      },
    })
  : undefined
---

<Base
  locale={locale}
  title={showcase?.name ?? t('errors.notFoundTitle')}
  description={description}
  ogImage={showcase ? paths.og(locale, 'escaparates', showcase.slug) : undefined}
  jsonLd={jsonLd}
>
  {!showcase ? (
    <NotFound locale={locale} />
  ) : (
    <>
      <ShowcaseHero
        eyebrow={t('showcase.eyebrow', { kind })}
        title={showcase.name}
        description={showcase.intro ?? undefined}
        logo={
          logo?.url
            ? {
                src: logo.sizes?.logo?.url ?? logo.url,
                alt: logo.alt,
                width: logo.sizes?.logo?.width ?? logo.width ?? undefined,
                height: logo.sizes?.logo?.height ?? logo.height ?? undefined,
              }
            : undefined
        }
        website={
          showcase.website ? { href: showcase.website, label: t('showcase.website') } : undefined
        }
        sponsor={
          presenter
            ? sponsorCredit(presenter, t('showcase.presentedBy'), `showcase:${showcase.slug}`)
            : undefined
        }
      />
      <section class="grid gap-4" aria-labelledby="showcase-shorts">
        <h2 id="showcase-shorts" class="m-0 font-display text-title uppercase">
          {t('showcase.selection', { count: shorts.length })}
        </h2>
        <ShortGrid
          items={shorts.map((short) =>
            toCard(toCardSource(short), locale, t, paths.short(locale, short.slug), clock),
          )}
        />
      </section>
    </>
  )}
</Base>
