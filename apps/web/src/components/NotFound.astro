---
import type { Locale } from '@shortix/i18n'
import { Button } from '@shortix/ui'
import { paths, translator } from '../lib/i18n.ts'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const t = translator(locale)
---

<section class="grid gap-4 max-w-synopsis">
  <h1 class="m-0 font-display text-display-l uppercase">{t('errors.notFoundTitle')}</h1>
  <p class="m-0 text-body-l text-ink-muted">{t('errors.notFound')}</p>
  <div>
    <Button variant="secondary" href={paths.home(locale)}>
      {t('errors.backHome')}
    </Button>
  </div>
</section>
