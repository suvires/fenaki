---
import { createRichTranslator, type Locale } from '@fenaki/i18n'
import { AccentHeadline } from '@fenaki/ui'
import { WaitlistForm } from '../islands/WaitlistForm.tsx'
import { paths, translator } from '../lib/i18n.ts'
import RichText from './RichText.astro'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const t = translator(locale)
const rich = createRichTranslator(locale)

// Two-tone headline: the closing phrase, wherever each language puts it, in the accent colour.
const title = rich('landing.hero.title', { accent: { accent: t('landing.hero.titleAccent') } })

const privacyPolicy = {
  href: paths.legal(locale, 'privacidad'),
  label: t('legal.links.privacyPolicy'),
}
---

{/* Centred in the space main leaves between the header and the footer (Base.astro), in a narrow
    column; the lead and the form take its whole width. */}
<section class="w-full max-w-landing mx-auto grid gap-6 py-8">
  <AccentHeadline parts={title} as="h1" size="responsive" />
  <p class="m-0 text-body-l text-primary">{t('landing.hero.lead')}</p>
  <div id="waitlist" class="grid gap-3 scroll-mt-8">
    <WaitlistForm client:load locale={locale} />
    <p class="m-0 text-small text-secondary">
      <RichText locale={locale} messageKey="waitlist.privacy" parts={{ privacyPolicy }} />
    </p>
  </div>
</section>
