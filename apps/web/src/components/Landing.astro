---
import type { Locale } from '@fenaki/i18n'
import { WaitlistForm } from '../islands/WaitlistForm.tsx'
import { paths, translator } from '../lib/i18n.ts'
import RichText from './RichText.astro'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const t = translator(locale)

const privacyPolicy = {
  href: paths.legal(locale, 'privacidad'),
  label: t('legal.links.privacyPolicy'),
}
---

{/* On desktop the hero fills the first screen below the header (its 24px top padding and
    24px logo, then main's 16px) with its content centred, and sits further in from the edges. */}
<section class="grid gap-6 py-8 md:py-0 md:px-12 md:min-h-[calc(100dvh-var(--spacing-12)-var(--spacing-4))] md:content-center">
  <h1 class="m-0 font-display text-display-l md:text-display-xl uppercase text-balance">
    {t('landing.hero.title')}
  </h1>
  <p class="m-0 max-w-hero-text text-body-l text-ink-muted">{t('landing.hero.lead')}</p>
  <div id="waitlist" class="grid gap-3 max-w-search scroll-mt-8">
    <WaitlistForm client:load locale={locale} />
    <p class="m-0 text-small text-ink-muted">
      <RichText locale={locale} messageKey="waitlist.privacy" parts={{ privacyPolicy }} />
    </p>
  </div>
</section>
