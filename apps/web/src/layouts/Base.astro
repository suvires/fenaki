---
import '../styles/global.css'
import type { Locale } from '@fenaki/i18n'
import { palettes } from '@fenaki/tokens'
import { SiteFooter, SiteHeader, Wordmark } from '@fenaki/ui'
import catalogShot from '../assets/landing-catalog.webp'
import { AccountSync } from '../islands/account/AccountSync.tsx'
import { CardPreview } from '../islands/CardPreview.tsx'
import { loadAccountState } from '../lib/account/data.ts'
import { paths, translator } from '../lib/i18n.ts'
import { contactLinks } from '../lib/contact.ts'
import { contactEmail, csp, siteMode, siteUrl, umami } from '../lib/services.ts'
import { absoluteUrl, hreflangLinks, jsonLdScript, type Alternates } from '../lib/seo.ts'

interface Props {
  locale: Locale
  /** The light from above at the top of the page: the home page only. */
  glow?: boolean
  /**
   * Before launch, the landing page's layout: content centred between the header and the footer,
   * over the tilted screenshot of the catalog. The landing and its waitlist confirmation only.
   */
  backdrop?: boolean
  /** The home page: its hero sits close to the header. Every other page gets more room above. */
  home?: boolean
  title?: string
  description?: string
  /** Pages that only make sense from a link, such as the waitlist confirmation. */
  noindex?: boolean
  /** The canonical path, when it is not the requested one (filtered or paged lists). */
  canonicalPath?: string
  /** The page in each locale, when its slug is localized. */
  alternates?: Alternates
  /** The Open Graph image, generated in the brand style (see /og/). */
  ogImage?: string
  ogType?: 'website' | 'video.other' | 'profile'
  /** schema.org structured data. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[]
}

const {
  locale,
  glow = false,
  backdrop = false,
  home = false,
  title,
  description,
  noindex = false,
  canonicalPath = Astro.url.pathname,
  alternates,
  ogImage = paths.ogPage(locale, 'site'),
  ogType = 'website',
  jsonLd,
} = Astro.props
// This environment's origins, next to the hashes Astro adds to the page's policy. Only while
// rendering a page: Astro ignores additions made earlier, in middleware. No policy in `astro dev`.
for (const resource of csp.scriptResources) Astro.csp?.insertScriptResource(resource)
for (const directive of csp.directives) Astro.csp?.insertDirective(directive)

const t = translator(locale)
const landing = siteMode === 'landing'
// A signed-in viewer's list and ratings go into the page, so every card knows what is saved and
// rated without asking (lib/accountClient.ts). The pages of the same request share the read.
const member = landing ? undefined : Astro.locals.member
const accountState = member
  ? await loadAccountState(member, locale).catch(() => undefined)
  : undefined
const pageTitle = title
  ? `${title} · ${t('site.name')}`
  : `${t('site.name')} · ${t('site.tagline')}`

const metaDescription = description ?? t('site.description')
const canonical = absoluteUrl(siteUrl, canonicalPath)
const image = absoluteUrl(siteUrl, ogImage)
const contact = contactLinks(contactEmail, t)
const legalLinks = [
  { label: t('footer.links.legalNotice'), href: paths.legal(locale, 'aviso-legal') },
  { label: t('footer.links.privacy'), href: paths.legal(locale, 'privacidad') },
  { label: t('footer.links.cookies'), href: paths.legal(locale, 'cookies') },
]
// Before launch the landing page only links the legal pages: there is no catalog to talk about.
const footerLinks = landing
  ? legalLinks
  : [
      { label: t('footer.links.browse'), href: paths.browse(locale) },
      ...(contact ? [contact.propose] : []),
      { label: t('footer.links.takedown'), href: paths.legal(locale, 'retirada-de-contenidos') },
      { label: t('footer.links.sponsor'), href: paths.sponsor(locale, 'collection') },
      { label: t('footer.links.showcase'), href: paths.sponsor(locale, 'showcase') },
      ...legalLinks,
      { label: t('footer.links.terms'), href: paths.legal(locale, 'terminos-de-uso') },
      { label: t('footer.links.playerSettings'), href: paths.playerSettings(locale) },
      { label: t('footer.links.credits'), href: paths.credits(locale) },
    ]
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content={palettes.dark['background-canvas']} />
    <meta name="color-scheme" content="dark" />
    <title>{pageTitle}</title>
    <meta name="description" content={metaDescription} />
    {noindex ? (
      <meta name="robots" content="noindex, follow" />
    ) : (
      <>
        <link rel="canonical" href={canonical} />
        {hreflangLinks(siteUrl, canonicalPath, alternates).map((link) => (
          <link rel="alternate" hreflang={link.hreflang} href={link.href} />
        ))}
      </>
    )}
    <meta property="og:site_name" content={t('site.name')} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title ?? pageTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title ?? pageTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={image} />
    {jsonLd && <script type="application/ld+json" set:html={jsonLdScript(jsonLd)} />}
    {umami && (
      <script
        is:inline
        defer
        src={umami.scriptUrl}
        data-website-id={umami.websiteId}
        data-exclude-search="true"
      />
    )}
  </head>
  <body
    data-signed-in={member ? 'true' : undefined}
    class:list={[
      // A column at least as tall as the window: main grows, so the footer always sits at the bottom.
      // isolate: the landing page's backdrop (in main) sits behind everything, above the body colour.
      'relative isolate min-h-dvh overflow-x-hidden flex flex-col',
      // The home page: a light from above, like a screen glowing in a dark room. A huge ellipse
      // centred above the page (radial, so it arcs: brighter in the middle than at the sides), in
      // the glow colour at the glow opacity, fading to transparent; and a black band behind the
      // header that fades within the first tenth. The ellipse reaches transparent at 58 % of its
      // radius, just above the area's bottom edge (60 % at its centre), so it never ends in a cut.
      glow &&
        'bg-[linear-gradient(to_bottom,var(--background-color-raised),transparent_10%),radial-gradient(250%_250%_at_50%_-50%,color-mix(in_oklab,var(--color-glow)_var(--opacity-glow),transparent)_20%,transparent_58%)] bg-no-repeat bg-size-[100%_var(--page-glow-height)]',
    ]}
  >
    {accountState && (
      <script
        type="application/json"
        id="fenaki-account"
        set:html={JSON.stringify(accountState).replace(/</g, '\\u003c')}
      />
    )}
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:p-2 focus:bg-raised focus:focus-ring rounded-sm"
    >
      {t('site.skipToContent')}
    </a>
    {landing ? (
      <div
        data-site-header
        class="sticky top-0 z-20 bg-transparent data-scrolled:bg-raised transition-colors duration-(--site-header-duration) ease-standard motion-reduce:transition-none"
      >
        <header class="w-full mx-auto max-w-page flex items-center px-4 md:px-8 py-6">
          <a
            href={paths.home(locale)}
            class="inline-flex text-primary rounded-xs focus-visible:focus-ring"
          >
            <Wordmark label={t('site.name')} className="h-6 w-auto" />
          </a>
        </header>
      </div>
    ) : (
      <div
        data-site-header
        class="sticky top-0 z-20 bg-transparent data-scrolled:bg-raised transition-colors duration-(--site-header-duration) ease-standard motion-reduce:transition-none"
      >
        <SiteHeader
          client:load
          className="mx-auto max-w-page px-4 md:px-8 py-6"
          home={{ href: paths.home(locale), label: t('site.name') }}
          navLabel={t('header.nav')}
          links={[
            {
              label: t('header.genres'),
              href: paths.browse(locale),
              current: Astro.url.pathname === paths.browse(locale),
            },
            {
              label: t('header.latest'),
              href: paths.latest(locale),
              current: Astro.url.pathname === paths.latest(locale),
            },
            {
              label: t('header.myList'),
              href: paths.myList(locale),
              current: Astro.url.pathname === paths.myList(locale),
            },
          ]}
          search={{
            action: paths.search(locale),
            name: 'q',
            label: t('search.label'),
            placeholder: t('search.placeholder'),
            toggleLabel: t('header.searchToggle'),
            clearLabel: t('header.searchClear'),
          }}
          account={
            member
              ? {
                  member: {
                    initial: Array.from(member.name || member.email)[0]?.toUpperCase() ?? '?',
                    label: t('header.accountMenu.label'),
                    links: [
                      {
                        label: t('header.accountMenu.myAccount'),
                        href: paths.account(locale),
                        current: Astro.url.pathname === paths.account(locale),
                      },
                      {
                        label: t('header.accountMenu.history'),
                        href: paths.history(locale),
                        current: Astro.url.pathname === paths.history(locale),
                      },
                    ],
                    signOut: {
                      label: t('header.accountMenu.signOut'),
                      action: '/api/account/logout',
                    },
                  },
                }
              : {
                  signIn: {
                    label: t('header.signIn'),
                    href: paths.signIn(locale),
                  },
                  signUp: { label: t('header.signUp'), href: paths.signUp(locale) },
                }
          }
          menuLabel={t('header.menu')}
        />
      </div>
    )}
    <main
      id="main"
      class:list={[
        'flex-1 w-full mx-auto max-w-page grid gap-12 px-4 md:px-8 pb-8',
        home ? 'pt-4' : 'pt-12',
        // The landing page's hero sits centred between the header and the footer.
        landing && backdrop ? 'relative content-center' : 'content-start',
      ]}
    >
      {landing && backdrop && (
        // Before launch, a glimpse of the catalog behind the hero: a screenshot of the home page tilted
        // in perspective, dimmed, and fading into the page colour at the top and the bottom so it never
        // meets the header or the footer with an edge. It spans the window's width but only main's height:
        // it never runs under the footer.
        <div
          aria-hidden="true"
          class="pointer-events-none absolute inset-y-0 left-1/2 w-screen -translate-x-1/2 -z-10 overflow-hidden [perspective:1600px]"
        >
          <img
            src={catalogShot.src}
            alt=""
            width={catalogShot.width}
            height={catalogShot.height}
            decoding="async"
            class="absolute left-1/2 top-1/2 w-[max(105%,900px)] max-w-none opacity-(--opacity-backdrop) [transform:translate(-50%,-46%)_rotateX(32deg)_rotateZ(-8deg)]"
          />
          <div class="absolute inset-0 bg-[linear-gradient(to_bottom,var(--background-color-canvas)_8%,transparent_35%,transparent_65%,var(--background-color-canvas)_92%)]" />
        </div>
      )}
      <slot />
    </main>
    {/* One island for every card on the page: the floating preview of the card under the pointer. */}
    {member && <AccountSync client:idle locale={locale} />}
    {!landing && (
      <CardPreview
        client:idle
        locale={locale}
        labels={{
          play: t('preview.play'),
          addToList: t('short.addToList'),
          inMyList: t('short.inMyList'),
          more: t('preview.more'),
          directedBy: t('short.directedBy', { names: '{names}' }),
          rating: {
            rate: t('preview.rate'),
            dislike: t('preview.dislike'),
            like: t('preview.like'),
            love: t('preview.love'),
          },
        }}
      />
    )}
    <script>
      // The header is see-through at the top and turns solid once the page has scrolled past
      // the main area's top padding, in both modes (the landing page's header is only the wordmark).
      const header = document.querySelector<HTMLElement>('[data-site-header]')
      const main = document.getElementById('main')
      // The light at the top of catalog pages ends halfway below the element marked data-glow-end (the
      // home hero); without one it keeps the --page-glow-height token's height.
      const glowEnd = document.querySelector<HTMLElement>('[data-glow-end]')
      if (glowEnd) {
        const fit = () => {
          // Halfway into the gap that follows it, so it fades out before the next block.
          const gap = main ? parseFloat(getComputedStyle(main).rowGap) || 0 : 0
          const bottom = glowEnd.getBoundingClientRect().bottom + window.scrollY + gap / 2
          document.body.style.setProperty('--page-glow-height', `${Math.round(bottom)}px`)
        }
        fit()
        new ResizeObserver(fit).observe(glowEnd)
      }
      // Rails with arrows are sliders: the arrows move the row about one screen, and show only
      // where there is more to see (data-can-previous / data-can-next on the rail). Delegated, so
      // rails rendered later by islands («Mi lista») work too.
      const railOf = (target: EventTarget | null) =>
        target instanceof Element ? target.closest<HTMLElement>('[data-rail]') : null
      const trackOf = (rail: HTMLElement) => rail.querySelector<HTMLElement>('[data-rail-track]')
      const syncRail = (rail: HTMLElement) => {
        const track = trackOf(rail)
        if (!track) return
        const max = track.scrollWidth - track.clientWidth
        rail.toggleAttribute('data-can-previous', track.scrollLeft > 1)
        rail.toggleAttribute('data-can-next', track.scrollLeft < max - 1)
      }
      const syncAll = () => document.querySelectorAll<HTMLElement>('[data-rail]').forEach(syncRail)
      syncAll()
      window.addEventListener('resize', syncAll, { passive: true })
      document.addEventListener('pointerover', (event) => {
        const rail = railOf(event.target)
        if (rail) syncRail(rail)
      })
      document.addEventListener('focusin', (event) => {
        const rail = railOf(event.target)
        if (rail) syncRail(rail)
      })
      document.addEventListener(
        'scroll',
        (event) => {
          const rail = railOf(event.target)
          if (rail) syncRail(rail)
        },
        { capture: true, passive: true },
      )
      document.addEventListener('click', (event) => {
        const button =
          event.target instanceof Element
            ? event.target.closest('[data-rail-previous], [data-rail-next]')
            : null
        const rail = railOf(button)
        const track = rail && trackOf(rail)
        if (!button || !track) return
        const direction = button.hasAttribute('data-rail-next') ? 1 : -1
        const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches
        track.scrollBy({
          left: direction * track.clientWidth * 0.9,
          behavior: still ? 'auto' : 'smooth',
        })
      })
      if (header && main) {
        let queued = false
        const update = () => {
          queued = false
          const threshold = parseFloat(getComputedStyle(main).paddingTop) || 0
          header.toggleAttribute('data-scrolled', window.scrollY > threshold)
        }
        update()
        window.addEventListener(
          'scroll',
          () => {
            if (queued) return
            queued = true
            requestAnimationFrame(update)
          },
          { passive: true },
        )
      }
    </script>
    <SiteFooter
      className="w-full mx-auto max-w-page px-4 md:px-8 pb-8"
      label={t('footer.label')}
      links={footerLinks}
      brand={t('site.name')}
    />
  </body>
</html>
