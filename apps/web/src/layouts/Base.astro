---
import '../styles/global.css'
import type { Locale } from '@shortix/i18n'
import { SearchField, SiteFooter } from '@shortix/ui'
import { paths, translator } from '../lib/i18n.ts'
import { siteMode, umami } from '../lib/services.ts'

interface Props {
  locale: Locale
  title?: string
  description?: string
  /** The search page has its own field. */
  showSearch?: boolean
  /** Pages that only make sense from a link, such as the waitlist confirmation. */
  noindex?: boolean
}

const { locale, title, description, showSearch = true, noindex = false } = Astro.props
const t = translator(locale)
const landing = siteMode === 'landing'
const pageTitle = title
  ? `${title} · ${t('site.name')}`
  : `${t('site.name')} · ${t('site.tagline')}`

const footerGroups = [
  ...(landing
    ? [
        {
          title: t('footer.groups.shortix'),
          links: [
            { label: t('footer.links.what'), href: paths.landingSection(locale, 'what') },
            { label: t('footer.links.legal'), href: paths.landingSection(locale, 'legal') },
            { label: t('footer.links.faq'), href: paths.landingSection(locale, 'faq') },
          ],
        },
      ]
    : []),
  {
    title: t('footer.groups.filmmakers'),
    links: [
      { label: t('footer.links.takedown'), href: paths.legal(locale, 'retirada-de-contenidos') },
    ],
  },
  {
    title: t('footer.groups.legal'),
    links: [
      { label: t('footer.links.legalNotice'), href: paths.legal(locale, 'aviso-legal') },
      { label: t('footer.links.privacy'), href: paths.legal(locale, 'privacidad') },
      { label: t('footer.links.cookies'), href: paths.legal(locale, 'cookies') },
    ],
  },
]
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <title>{pageTitle}</title>
    <meta name="description" content={description ?? t('site.description')} />
    {noindex && <meta name="robots" content="noindex" />}
    {umami && (
      <script
        is:inline
        defer
        src={umami.scriptUrl}
        data-website-id={umami.websiteId}
        data-exclude-search="true"
      />
    )}
  </head>
  <body class="min-h-dvh overflow-x-hidden">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:p-2 focus:bg-sala-1 focus:focus-ring rounded-sm"
    >
      {t('site.skipToContent')}
    </a>
    <header class="mx-auto max-w-page flex flex-wrap items-center justify-between gap-3 px-4 md:px-8 pt-6">
      <a
        href={paths.home(locale)}
        class="font-display text-title uppercase text-ink no-underline rounded-xs focus-visible:focus-ring"
      >
        {t('site.name')}
      </a>
      {showSearch && !landing && (
        <form action={paths.search(locale)} method="get" role="search" class="w-full max-w-search">
          <SearchField
            name="q"
            id="site-search"
            label={t('search.label')}
            placeholder={t('search.placeholder')}
          />
        </form>
      )}
    </header>
    <main id="main" class="mx-auto max-w-page grid gap-12 px-4 md:px-8 py-8">
      <slot />
    </main>
    <SiteFooter
      className="mx-auto max-w-page px-4 md:px-8 pb-8"
      label={t('footer.label')}
      groups={footerGroups}
      tagline={t('footer.tagline')}
    />
  </body>
</html>
