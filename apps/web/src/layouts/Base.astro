---
import '../styles/global.css'
import type { Locale } from '@fenaki/i18n'
import { SearchField, SiteFooter } from '@fenaki/ui'
import { paths, translator } from '../lib/i18n.ts'
import { contactLinks } from '../lib/contact.ts'
import { contactEmail, csp, siteMode, siteUrl, umami } from '../lib/services.ts'
import { absoluteUrl, hreflangLinks, jsonLdScript, type Alternates } from '../lib/seo.ts'

interface Props {
  locale: Locale
  title?: string
  description?: string
  /** The search page has its own field. */
  showSearch?: boolean
  /** Pages that only make sense from a link, such as the waitlist confirmation. */
  noindex?: boolean
  /** The canonical path, when it is not the requested one (filtered or paged lists). */
  canonicalPath?: string
  /** The page in each locale, when its slug is localized. */
  alternates?: Alternates
  /** The Open Graph image, generated in the brand style (see /og/). */
  ogImage?: string
  ogType?: 'website' | 'video.other' | 'profile'
  /** schema.org structured data. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[]
}

const {
  locale,
  title,
  description,
  showSearch = true,
  noindex = false,
  canonicalPath = Astro.url.pathname,
  alternates,
  ogImage = `/og/${locale}/site.png`,
  ogType = 'website',
  jsonLd,
} = Astro.props
// This environment's origins, next to the hashes Astro adds to the page's policy. Only while
// rendering a page: Astro ignores additions made earlier, in middleware. No policy in `astro dev`.
for (const resource of csp.scriptResources) Astro.csp?.insertScriptResource(resource)
for (const directive of csp.directives) Astro.csp?.insertDirective(directive)

const t = translator(locale)
const landing = siteMode === 'landing'
const pageTitle = title
  ? `${title} · ${t('site.name')}`
  : `${t('site.name')} · ${t('site.tagline')}`

const metaDescription = description ?? t('site.description')
const canonical = absoluteUrl(siteUrl, canonicalPath)
const image = absoluteUrl(siteUrl, ogImage)
const contact = contactLinks(contactEmail, t)
const footerGroups = [
  ...(landing
    ? [
        {
          title: t('footer.groups.fenaki'),
          links: [
            { label: t('footer.links.what'), href: paths.landingSection(locale, 'what') },
            { label: t('footer.links.legal'), href: paths.landingSection(locale, 'legal') },
            { label: t('footer.links.faq'), href: paths.landingSection(locale, 'faq') },
          ],
        },
      ]
    : [
        {
          title: t('footer.groups.fenaki'),
          links: [{ label: t('footer.links.browse'), href: paths.browse(locale) }],
        },
      ]),
  {
    title: t('footer.groups.filmmakers'),
    links: [
      ...(contact ? [contact.propose] : []),
      { label: t('footer.links.takedown'), href: paths.legal(locale, 'retirada-de-contenidos') },
    ],
  },
  {
    title: t('footer.groups.organizations'),
    links: [
      { label: t('footer.links.sponsor'), href: paths.sponsor(locale, 'collection') },
      { label: t('footer.links.showcase'), href: paths.sponsor(locale, 'showcase') },
    ],
  },
  {
    title: t('footer.groups.legal'),
    links: [
      { label: t('footer.links.legalNotice'), href: paths.legal(locale, 'aviso-legal') },
      { label: t('footer.links.privacy'), href: paths.legal(locale, 'privacidad') },
      { label: t('footer.links.cookies'), href: paths.legal(locale, 'cookies') },
    ],
  },
]
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <title>{pageTitle}</title>
    <meta name="description" content={metaDescription} />
    {noindex ? (
      <meta name="robots" content="noindex, follow" />
    ) : (
      <>
        <link rel="canonical" href={canonical} />
        {hreflangLinks(siteUrl, canonicalPath, alternates).map((link) => (
          <link rel="alternate" hreflang={link.hreflang} href={link.href} />
        ))}
      </>
    )}
    <meta property="og:site_name" content={t('site.name')} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title ?? t('site.name')} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title ?? t('site.name')} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={image} />
    {jsonLd && <script type="application/ld+json" set:html={jsonLdScript(jsonLd)} />}
    {umami && (
      <script
        is:inline
        defer
        src={umami.scriptUrl}
        data-website-id={umami.websiteId}
        data-exclude-search="true"
      />
    )}
  </head>
  <body class="min-h-dvh overflow-x-hidden">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:p-2 focus:bg-sala-1 focus:focus-ring rounded-sm"
    >
      {t('site.skipToContent')}
    </a>
    <header class="mx-auto max-w-page flex flex-wrap items-center justify-between gap-3 px-4 md:px-8 pt-6">
      <a
        href={paths.home(locale)}
        class="font-display text-title uppercase text-ink no-underline rounded-xs focus-visible:focus-ring"
      >
        {t('site.name')}
      </a>
      {showSearch && !landing && (
        <form action={paths.search(locale)} method="get" role="search" class="w-full max-w-search">
          <SearchField
            name="q"
            id="site-search"
            label={t('search.label')}
            placeholder={t('search.placeholder')}
          />
        </form>
      )}
    </header>
    <main id="main" class="mx-auto max-w-page grid gap-12 px-4 md:px-8 py-8">
      <slot />
    </main>
    <SiteFooter
      className="mx-auto max-w-page px-4 md:px-8 pb-8"
      label={t('footer.label')}
      groups={footerGroups}
      tagline={t('footer.tagline')}
      tmdbCredit={{
        text: t('footer.tmdb.text'),
        href: 'https://www.themoviedb.org',
        logoLabel: t('footer.tmdb.logo'),
      }}
    />
  </body>
</html>
