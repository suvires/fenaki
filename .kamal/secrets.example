# Kamal secrets for production (config/deploy.yml). Every value comes from an environment
# variable: GitHub Actions sets them from the repository secrets, and a deploy from a laptop
# exports them from a file outside any repository first (docs/deploy.md, "Secrets").
#
#   cp .kamal/secrets.example .kamal/secrets      # .kamal/secrets is gitignored
#
# Never write a real value here or in .kamal/secrets. Generate every password, secret and token
# with `openssl rand -hex 32`: hexadecimal only, so they are safe inside the URLs below.
# Besides these, Kamal needs FENAKI_HOST (the server's IP address) in the environment.

# GitHub Container Registry. In CI, the workflow's own GITHUB_TOKEN; on a laptop, a classic
# personal access token of `suvires` with the read:packages and write:packages scopes.
KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD

# PostgreSQL: the main user (Fenaki's database, backups) and the listmonk and Umami users.
POSTGRES_PASSWORD=$POSTGRES_PASSWORD
LISTMONK_DB_PASSWORD=$LISTMONK_DB_PASSWORD
UMAMI_DB_PASSWORD=$UMAMI_DB_PASSWORD
DATABASE_URL=postgres://fenaki:${POSTGRES_PASSWORD}@fenaki-postgres:5432/fenaki
UMAMI_DATABASE_URL=postgresql://umami:${UMAMI_DB_PASSWORD}@fenaki-postgres:5432/umami

# Payload: signs sessions and tokens. Changing it logs every editor out.
PAYLOAD_SECRET=$PAYLOAD_SECRET

# Meilisearch. The CMS uses the master key; the site gets a search-only key. Meilisearch derives a
# key from its uid and the master key (HMAC-SHA256), so it is computed here (with Ruby, which
# is wherever Kamal runs) instead of stored:
# `kamal search-key` creates it on the server with this uid. The uid is not a secret.
MEILI_MASTER_KEY=$MEILI_MASTER_KEY
MEILI_SEARCH_KEY_UID=8a1c2e9e-3c51-4f3b-9d6e-5b1d1c0f7a42
MEILISEARCH_SEARCH_KEY=$(ruby -ropenssl -e 'print OpenSSL::HMAC.hexdigest("SHA256", ARGV[0], ARGV[1])' "$MEILI_MASTER_KEY" "$MEILI_SEARCH_KEY_UID")

# listmonk: the `admin` user's password (set on install) and the API token of `fenaki-web`, the
# user the site and the CMS call the API with (`kamal listmonk-token` sets it).
LISTMONK_ADMIN_PASSWORD=$LISTMONK_ADMIN_PASSWORD
LISTMONK_API_TOKEN=$LISTMONK_API_TOKEN

# Umami: the app secret and the `admin` user's password (`kamal setup-services` replaces the
# default one with it).
UMAMI_APP_SECRET=$UMAMI_APP_SECRET
UMAMI_ADMIN_PASSWORD=$UMAMI_ADMIN_PASSWORD

# Amazon SES SMTP credentials (EU region; not the AWS access keys): listmonk and Payload's emails.
SES_SMTP_USERNAME=$SES_SMTP_USERNAME
SES_SMTP_PASSWORD=$SES_SMTP_PASSWORD

# The mailbox hola@fenaki.tv (OVHcloud Zimbra), for the sales CRM: outreach through its SMTP
# server, replies read over IMAP. Its password; the host, ports and user are in config/deploy.yml.
MAILBOX_PASSWORD=$MAILBOX_PASSWORD

# Cloudflare Tunnel token: `tofu output -raw tunnel_token` in infra/cloudflare.
CLOUDFLARE_TUNNEL_TOKEN=$CLOUDFLARE_TUNNEL_TOKEN

# Optional metadata APIs for «Add from URL» and the nightly embed checker. Empty: public oEmbed
# only. A YouTube Data API v3 key (Google Cloud, restricted to that API) and a TMDB v3 API key or
# v4 read access token.
YOUTUBE_API_KEY=$YOUTUBE_API_KEY
TMDB_API_KEY=$TMDB_API_KEY

# Optional. A Vimeo app access token (a free app at developer.vimeo.com, a «Public» token with no
# scopes): lets the channel scan list a Vimeo user's or channel's whole catalogue and read each
# video's language and subtitle tracks. Empty: the user's public pages and the RSS feed.
VIMEO_ACCESS_TOKEN=$VIMEO_ACCESS_TOKEN

# Optional. An Anthropic API key: Claude prepares a proposal (language, credits, synopsis, whether
# it is a complete short) for every short in the review queue. Empty: the feature is off.
ANTHROPIC_API_KEY=$ANTHROPIC_API_KEY

# Sentry DSN (EU region). Empty disables error tracking.
SENTRY_DSN=$SENTRY_DSN

# Off-site backups: an S3-compatible bucket (Cloudflare R2 or Backblaze B2) and an API key that
# can only read and write that bucket. The endpoint is e.g.
# https://<account-id>.eu.r2.cloudflarestorage.com (R2, EU jurisdiction) or
# https://s3.eu-central-003.backblazeb2.com (B2). For B2, set BACKUP_S3_PROVIDER: Other in
# config/deploy.yml.
BACKUP_S3_ENDPOINT=$BACKUP_S3_ENDPOINT
BACKUP_S3_BUCKET=$BACKUP_S3_BUCKET
BACKUP_S3_ACCESS_KEY_ID=$BACKUP_S3_ACCESS_KEY_ID
BACKUP_S3_SECRET_ACCESS_KEY=$BACKUP_S3_SECRET_ACCESS_KEY
# The public half of the backup key pair (`age-keygen`, starts with age1). The private half
# stays offline, in the password manager: without it no backup can be read.
BACKUP_AGE_RECIPIENT=$BACKUP_AGE_RECIPIENT
# The uptime monitor's heartbeat URL for the daily backup (it alerts when a day is missed).
BACKUP_HEARTBEAT_URL=$BACKUP_HEARTBEAT_URL
