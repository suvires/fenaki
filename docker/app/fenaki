#!/bin/sh
# Entry point of the production image. Each Kamal role runs one command:
#   web             the Astro site on $PORT (4321)
#   cms             applies pending migrations, then serves Payload on port 3000
#   jobs            the background jobs worker (same schedule as `pnpm --filter @fenaki/cms jobs`)
#   migrate         applies pending migrations and exits
#   payload <args>  the Payload CLI, e.g. `payload migrate:status`
#   setup-services  configures listmonk and Umami (`pnpm setup:services`)
# Anything else runs as a plain command, e.g. `kamal app exec --roles cms "sh"`.
set -e

payload() {
  cd /app/apps/cms
  node node_modules/payload/bin.js "$@"
}

case "$1" in
  web)
    cd /app/apps/web
    exec node dist/server/entry.mjs
    ;;
  cms)
    # The primary Kamal role: the other roles wait until it is healthy, so they never start
    # against a schema that is not migrated yet. A failed migration fails the deploy.
    payload migrate
    exec node node_modules/next/dist/bin/next start --port 3000
    ;;
  jobs)
    # Jobs a stopped worker left half done go back to the queue first.
    payload run src/jobs/releaseInterrupted.ts
    # Two workers, so a long job never holds back the short ones: `long` runs the embed check and
    # the channel scans one at a time; `default` runs the rest, 50 every 10 seconds (a night's embed
    # check queues one search sync per short it touches). Each handles its queue's schedules. Of
    # the role's 600 MB, 320 go to the long worker's heap (the check reads the whole catalog) and
    # 200 to the other's.
    node --max-old-space-size=320 node_modules/payload/bin.js jobs:run --cron '*/30 * * * * *' --limit 1 --queue long --handle-schedules &
    long=$!
    node --max-old-space-size=200 node_modules/payload/bin.js jobs:run --cron '*/10 * * * * *' --limit 50 --queue default --handle-schedules &
    default=$!
    trap 'kill "$long" "$default" 2>/dev/null' TERM INT
    # Whichever stops first stops the container, and the restart brings both back.
    while kill -0 "$long" 2>/dev/null && kill -0 "$default" 2>/dev/null; do sleep 5; done
    kill "$long" "$default" 2>/dev/null
    exit 1
    ;;
  migrate)
    payload migrate
    ;;
  payload)
    shift
    payload "$@"
    ;;
  setup-services)
    cd /app/apps/web
    exec node scripts/setup-services.ts
    ;;
  *)
    exec "$@"
    ;;
esac
