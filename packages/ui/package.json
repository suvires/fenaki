    "test:visual:update": "node scripts/visual.ts --update-snapshots"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@storybook/addon-a11y": "10.6.3",
    "@storybook/addon-docs": "10.6.3",
    "@storybook/react-vite": "10.6.3",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "storybook": "10.6.3",
    "tailwindcss": "4.3.3",
    "vite": "8.3.5"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "dependencies": {
    "@radix-ui/react-toggle-group": "1.2.1",
    "@fenaki/i18n": "workspace:*",
    "@fenaki/tokens": "workspace:*"
