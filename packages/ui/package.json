{
  "name": "@fenaki/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Fenaki React components, built on design tokens and accessible primitives.",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles.css",
    "./wordmark.svg": "./src/assets/wordmark.svg"
  },
  "scripts": {
